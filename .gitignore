# macOS
.DS_Store

# Per-machine overrides (engine pin, remapped ports) — written by the setup
# scripts and `kingo fixports`. Must stay untracked so `kingo update` can
# always `git pull` cleanly on student laptops.
.env.local

# Claude Code local session state
.claude/

# editor / local
*.swp
*.log

# USB offline bundle written by `kingo bundle` (~13 GB each) — arch-stamped
# (kingo-images-amd64.tar / -arm64.tar) plus the legacy single name.
kingo-images*.tar

# kingo-owned neutral registry auth (shields podman pulls from broken
# Docker credential helpers — gcloud/ECR leftovers from other courses)
.kingo-auth/

# NOTE: .env is committed ON PURPOSE — classroom credentials are public-by-design
# and localhost-only (see PLAN-NATIVE-STACK.md §5). Do not add .env here.

# a leftover from an interrupted `kingo bundle` (~13 GB)
kingo-images*.tar.part

# Note written by `kingo load`: which USB bundle this machine installed from
# (per-machine fact, like .env.local — never committed).
.kingo-install-source

# Files students drop into the shared folder (mounted into Langflow at
# /app/shared) — the folder itself is tracked via .gitkeep, its contents are not.
shared/*
!shared/.gitkeep
