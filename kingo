#!/usr/bin/env bash
# kingo — classroom stack helper (native, engine-agnostic).
# Runs the container stack directly on a laptop with Podman (preferred) or
# Docker. No VM. The ONE CLI for Mac, Linux, and Windows-inside-WSL2.
# Engine is auto-detected (override with KINGO_ENGINE).
set -euo pipefail

KINGO_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}" 2>/dev/null || echo "${BASH_SOURCE[0]}")")" && pwd)"
cd "$KINGO_DIR"

# .env holds the shared classroom defaults (committed). .env.local holds
# per-machine overrides — engine pin, moved ports — written by the setup
# scripts and 'kingo fixports'. It is gitignored, so students never edit the
# committed .env and 'kingo update' can always git pull cleanly.
#
# Self-heal Windows line endings / a UTF-8 BOM in .env.local first: editing it
# with Notepad over \\wsl$ adds both, and a single stray \r inside a value
# breaks the engine name, every port probe, and compose itself.
if [ -f ./.env.local ] && LC_ALL=C grep -qE $'\r|\xef\xbb\xbf' ./.env.local 2>/dev/null; then
  tr -d '\r' < ./.env.local | LC_ALL=C sed $'1s/^\xef\xbb\xbf//' > ./.env.local.clean
  mv ./.env.local.clean ./.env.local
fi
# Any KINGO_* variable given on the command line still beats both files.
_cli_overrides="$(env | LC_ALL=C grep -E '^KINGO_[A-Z0-9_]+=' || true)"
# shellcheck disable=SC1091
set -a; source ./.env; [ -f ./.env.local ] && source ./.env.local; set +a
if [ -n "$_cli_overrides" ]; then
  while IFS= read -r _kv; do export "$_kv"; done <<<"$_cli_overrides"
fi

# Effective host ports (defaults match the guides; overridable via KINGO_PORT_*).
P_LANGFLOW=${KINGO_PORT_LANGFLOW:-7860}
P_N8N=${KINGO_PORT_N8N:-5678}
P_JUPYTERLAB=${KINGO_PORT_JUPYTERLAB:-8888}
P_JUPYTERHUB=${KINGO_PORT_JUPYTERHUB:-8000}
P_MCP=${KINGO_PORT_MCP:-4040}
P_METABASE=${KINGO_PORT_METABASE:-3000}
P_CLOUDBEAVER=${KINGO_PORT_CLOUDBEAVER:-8978}
P_QDRANT=${KINGO_PORT_QDRANT:-6333}
P_QDRANT_GRPC=${KINGO_PORT_QDRANT_GRPC:-6334}
P_POSTGRES=${KINGO_PORT_POSTGRES:-5432}

die()  { echo "ERROR: $*" >&2; exit 1; }
warn() { echo "WARN: $*" >&2; }

# Catch a typo'd engine name in .env.local (or the environment) up front —
# otherwise it only surfaces deep inside ensure_ready, and doctor would
# happily report on a nonsense engine.
case "${KINGO_ENGINE:-}" in
  ''|podman|docker) ;;
  *) die "KINGO_ENGINE is '$KINGO_ENGINE' — it must be 'podman' or 'docker'. Check .env.local (or your shell environment)." ;;
esac

# ── Engine detection ─────────────────────────────────────────────────────────
# Order (per plan §4): $KINGO_ENGINE override → podman (usable or startable) →
# docker → podman as last resort (so the error points at podman setup).
ENGINE=""
select_engine() {
  if [ -n "${KINGO_ENGINE:-}" ]; then ENGINE="$KINGO_ENGINE"; return; fi
  if command -v podman >/dev/null 2>&1; then
    if podman info >/dev/null 2>&1; then ENGINE=podman; return; fi
    if podman machine list -q 2>/dev/null | grep -q .; then ENGINE=podman; return; fi
  fi
  if command -v docker >/dev/null 2>&1; then ENGINE=docker; return; fi
  if command -v podman >/dev/null 2>&1; then ENGINE=podman; return; fi
  die "No container engine found. Install Podman (recommended) or Docker Desktop — see docs/STUDENT-GUIDE-*.md."
}

# Make sure the engine can actually run containers (start podman machine if it
# exists but is stopped; tell the user to run setup if there is no machine).
ensure_ready() {
  case "$ENGINE" in
    podman)
      # The provider guard is not optional: without the docker-compose binary,
      # `podman compose` silently falls back to podman-compose, which breaks
      # this stack (plan §4).
      command -v docker-compose >/dev/null 2>&1 \
        || die "the docker-compose provider binary is missing — podman would fall back to podman-compose, which breaks this stack. Mac: brew install docker-compose. Linux/WSL: re-run setup/setup-linux.sh."
      # Rootless podman's Docker-compat API socket is a systemd USER unit and
      # is NOT enabled by default — the compose provider is a Docker client
      # and dies without it ("Cannot connect to the Docker daemon"; first
      # real WSL run, 2026-08-22). Self-heal by starting it. Macs are
      # unaffected (the podman machine serves the socket).
      if [ "$(uname -s)" = "Linux" ]; then
        if [ -d /run/systemd/system ]; then
          if ! systemctl --user is-active --quiet podman.socket 2>/dev/null; then
            systemctl --user enable --now podman.socket >/dev/null 2>&1 || true
            systemctl --user is-active --quiet podman.socket 2>/dev/null \
              || die "podman's API socket did not start. Look at: systemctl --user status podman.socket — then retry, or re-run setup/setup-linux.sh."
          fi
        elif grep -qi microsoft /proc/version 2>/dev/null; then
          die "this WSL Ubuntu runs without systemd, which rootless podman needs. In Windows PowerShell run 'wsl --update'; make sure /etc/wsl.conf contains '[boot]' and 'systemd=true'; then 'wsl --shutdown', reopen Ubuntu, and retry."
        fi
      fi
      if ! podman info >/dev/null 2>&1; then
        if podman machine list -q 2>/dev/null | grep -q .; then
          echo "Starting the Podman machine (this takes a few seconds) ..."
          podman machine start >/dev/null 2>&1 || true
        fi
        podman info >/dev/null 2>&1 \
          || die "Podman has no ready machine. Run the setup script once: setup/setup-mac.sh (Mac) or setup/setup-linux.sh (Linux, or inside WSL2 Ubuntu on Windows)."
      fi
      # podman itself is reachable now. On macOS the machine ALSO exposes a
      # Docker-API socket that the compose provider (docker-compose) talks to,
      # and it can go stale after sleep/wake while podman stays fine — then
      # every compose command dies with a raw "Cannot connect to the Docker
      # daemon" deep inside the provider. Probe it here so the cause is clear.
      # (Teardown doesn't reach this — cmd_down falls back to the engine CLI.)
      if [ "$(uname -s)" = Darwin ] && ! podman compose ls >/dev/null 2>&1; then
        die "the Podman machine is running, but the Docker-API socket that docker-compose needs is not responding (podman itself works — that's why 'podman ps' is fine).
   Restore it with:   podman machine stop && podman machine start
   Heads-up: that briefly stops ALL your podman containers, not only Kingo's.
   If you only want the Kingo stack DOWN, that no longer needs this socket — just run:  ./kingo down"
      fi
      return 0
      ;;
    docker)
      docker info >/dev/null 2>&1 \
        || die "Docker is installed but not running. Open Docker Desktop, wait until it says 'running', then try again."
      docker compose version >/dev/null 2>&1 \
        || die "Docker is running but has no Compose plugin ('docker compose'). Install Docker Desktop, or the docker-compose-plugin package on native Linux."
      return 0
      ;;
    *) die "Unknown engine '$ENGINE' (KINGO_ENGINE must be 'podman' or 'docker')." ;;
  esac
}

# All class images are PUBLIC — anonymous pulls must always work. But podman
# falls back to ~/.docker/config.json for registry auth, and the compose
# provider reads that file itself: a broken Docker credential helper from
# another course (gcloud with an expired token, ECR, …) then kills even
# anonymous pulls. Under podman, point both at a kingo-owned neutral config.
# (Deliberately NOT under docker: its config also carries the Desktop context,
# and the daemon resolves auth via the student's own config anyway — doctor
# diagnoses a broken helper there instead.)
neutral_auth() {
  [ "$ENGINE" = podman ] || return 0
  [ -n "${REGISTRY_AUTH_FILE:-}" ] && return 0   # explicit user choice wins
  mkdir -p .kingo-auth
  [ -f .kingo-auth/auth.json ]   || echo '{}' > .kingo-auth/auth.json
  [ -f .kingo-auth/config.json ] || echo '{}' > .kingo-auth/config.json
  export REGISTRY_AUTH_FILE="$KINGO_DIR/.kingo-auth/auth.json"
  export DOCKER_CONFIG="$KINGO_DIR/.kingo-auth"
}

# One wrapper every verb goes through: `podman compose ...` or `docker compose ...`.
compose() { neutral_auth; $ENGINE compose "$@"; }

# ── The service table: the ONE list every command derives from ───────────────
# DisplayName|ENV_SUFFIX|host port|health path|expected codes
#   suffix → the KINGO_PORT_<suffix> override (port already reflects overrides)
#   path 'tcp' → plain TCP probe;  path '-' → port-only (no health/status row)
# Health codes are the source of truth (plan §8): 4040/mcp answering 401
# without the bearer token IS healthy. Exact codes only — "any answer counts"
# once passed while a service was crash-looping. `kingo smoke` asserts this
# table matches compose.yml's published ports, so they cannot drift silently.
SERVICE_TABLE=(
  "JupyterLab|JUPYTERLAB|${P_JUPYTERLAB}|/api|200"
  "JupyterHub|JUPYTERHUB|${P_JUPYTERHUB}|/hub/api|200"
  "Jupyter MCP|MCP|${P_MCP}|/mcp|401"
  "Langflow|LANGFLOW|${P_LANGFLOW}|/health|200"
  "n8n|N8N|${P_N8N}|/healthz|200"
  "Metabase|METABASE|${P_METABASE}|/api/health|200"
  "CloudBeaver|CLOUDBEAVER|${P_CLOUDBEAVER}|/|200|301|302"
  "Qdrant|QDRANT|${P_QDRANT}|/readyz|200"
  "Qdrant gRPC|QDRANT_GRPC|${P_QDRANT_GRPC}|-|-"
  "PostgreSQL|POSTGRES|${P_POSTGRES}|tcp|-"
)

check() { # port path [want] -> 0 if the expected code(s) match
  local port="$1" path="$2" want="${3:-200}" code
  if [ "$path" = "tcp" ]; then
    (exec 3<>"/dev/tcp/127.0.0.1/$port") 2>/dev/null && { exec 3>&- 3<&-; return 0; } || return 1
  fi
  code=$(curl -s -o /dev/null -m 3 -w '%{http_code}' "http://127.0.0.1:${port}${path}" 2>/dev/null || echo 000)
  [ "$code" = 000 ] && return 1   # nothing answered (or curl is missing) — never "up"
  echo "$code" | grep -qE "^(${want})$"
}

wait_all() { # $1 = max attempts (10s apart)
  local attempt all s name suffix port path want
  for attempt in $(seq 1 "$1"); do
    all=1
    for s in "${SERVICE_TABLE[@]}"; do
      IFS='|' read -r name suffix port path want <<<"$s"
      [ "$path" = "-" ] && continue
      check "$port" "$path" "${want:-200}" || { all=0; break; }
    done
    [ "$all" = 1 ] && return 0
    echo "  waiting for services ($attempt/$1) — last not ready: ${name} ..."
    sleep 10
  done
  return 1
}

# ── First-run initialization (idempotent; absorbed from the old bake.sh) ──────
init_stack() {
  # Starter notebook the MCP server points at.
  $ENGINE exec kingo-jupyterlab bash -lc \
    'mkdir -p work && [ -f work/notebook.ipynb ] || printf "%s" "{\"cells\":[],\"metadata\":{},\"nbformat\":4,\"nbformat_minor\":5}" > work/notebook.ipynb' \
    2>/dev/null || warn "could not create the starter notebook (retry with: kingo up)"
  setup_metabase || warn "Metabase pre-setup skipped (worst case: you click through the wizard once)"
}

# Pre-provision the Metabase admin + classroom DB so students never see the
# setup wizard. Idempotent via the setup-token check; non-fatal on failure.
# JSON is parsed with grep (no python3 dependency on the host).
setup_metabase() {
  local mb="http://127.0.0.1:${P_METABASE}" props token sid
  props=$(curl -s -m 5 "$mb/api/session/properties" || true)
  # Gate on has-user-setup, NOT the setup-token: Metabase keeps a (now useless)
  # setup-token around even after an admin exists, so the token alone would make
  # this re-run the setup call and warn every time.
  echo "$props" | grep -q '"has-user-setup":true' && { echo "  Metabase already initialized."; return 0; }
  token=$(echo "$props" | grep -o '"setup-token":"[^"]*"' | cut -d'"' -f4 || true)
  [ -n "${token:-}" ] || { warn "Metabase not ready for pre-setup yet (skipping; re-run: kingo up)"; return 0; }
  sid=$(curl -s -m 15 -X POST "$mb/api/setup" -H 'Content-Type: application/json' -d "{
      \"token\": \"$token\",
      \"user\": {\"email\": \"$METABASE_ADMIN_EMAIL\", \"password\": \"$KINGO_STRONG_PASSWORD\",
                 \"first_name\": \"Kingo\", \"last_name\": \"Admin\", \"site_name\": \"Kingo Classroom\"},
      \"prefs\": {\"site_name\": \"Kingo Classroom\", \"allow_tracking\": false}
    }" | grep -o '"id":"[^"]*"' | head -1 | cut -d'"' -f4 || true)
  [ -n "${sid:-}" ] || { warn "Metabase setup call did not return a session"; return 0; }
  curl -s -m 15 -X POST "$mb/api/database" -H 'Content-Type: application/json' \
    -H "X-Metabase-Session: $sid" -d "{
      \"engine\": \"postgres\", \"name\": \"Classroom (PostgreSQL)\",
      \"details\": {\"host\": \"postgres\", \"port\": 5432, \"dbname\": \"classroom\",
                    \"user\": \"$KINGO_USER\", \"password\": \"$KINGO_PASSWORD\", \"ssl\": false}
    }" >/dev/null 2>&1 || warn "could not add the classroom DB to Metabase"
  echo "  Metabase admin + classroom DB provisioned."
}

# ── Commands ─────────────────────────────────────────────────────────────────
cmd_up() {
  select_engine; ensure_ready
  preflight_ports
  echo "Engine: $ENGINE. Starting the Kingo stack ..."
  # `up` builds the local jupyterhub image only if it's missing (first run);
  # use `kingo update` to force a rebuild after changing the Dockerfile.
  compose up -d
  echo "Waiting for all services to become healthy (first run pulls ~10 GB — be patient) ..."
  wait_all 90 || { echo; compose ps; die "not all services came up. See: ./kingo logs"; }
  echo "All services healthy. Running first-run setup ..."
  init_stack
  echo
  cmd_status
  echo
  echo "Ready. Run 'kingo credentials' for all URLs and logins."
}

# Tear the stack down WITHOUT the compose provider, using the engine CLI's own
# connection (which stays healthy on macOS even when the machine's Docker-API
# socket that docker-compose needs goes stale after sleep/wake). Scoped to
# Kingo's own containers + network by the compose project label (name prefix as
# a fallback) — never touches other Docker/Podman workloads on the machine.
cli_teardown() {
  local ids
  ids=$($ENGINE ps -aq --filter label=com.docker.compose.project=kingo 2>/dev/null)
  [ -n "$ids" ] || ids=$($ENGINE ps -aq --filter name=kingo- 2>/dev/null)
  if [ -n "$ids" ]; then
    # shellcheck disable=SC2086
    $ENGINE rm -f $ids >/dev/null 2>&1 || { $ENGINE stop $ids >/dev/null 2>&1; $ENGINE rm $ids >/dev/null 2>&1; }
  fi
  $ENGINE network rm kingo_default >/dev/null 2>&1 || true
}

cmd_down() {
  select_engine
  # Prefer a clean compose teardown. If the compose provider can't reach the
  # engine socket (the sleep/wake staleness above), fall back to the CLI so the
  # stack always comes down — a stuck-up stack was a real, confusing failure.
  if compose down; then release_after_down; return 0; fi
  warn "the compose provider could not reach the engine — taking the Kingo stack down directly instead (your other containers are untouched)."
  cli_teardown
  release_after_down
  echo "Kingo stack stopped."
}

cmd_status() {
  select_engine
  local all_up=1 any_up=0 s name suffix port path want st
  printf '%-14s %-8s %s\n' "SERVICE" "STATUS" "URL"
  for s in "${SERVICE_TABLE[@]}"; do
    IFS='|' read -r name suffix port path want <<<"$s"
    [ "$path" = "-" ] && continue
    # status is lenient (any answer = up); smoke enforces exact codes.
    if [ "$path" = "tcp" ]; then
      if check "$port" tcp; then st="up"; any_up=1; else st="DOWN"; all_up=0; fi
      printf '%-14s %-8s localhost:%s\n' "$name" "$st" "$port"
    else
      if check "$port" "$path" '[0-9]{3}'; then st="up"; any_up=1; else st="DOWN"; all_up=0; fi
      printf '%-14s %-8s http://localhost:%s\n' "$name" "$st" "$port"
    fi
  done
  if [ "$all_up" != 1 ]; then
    echo
    if [ "$any_up" = 0 ]; then
      # 'restart' after 'down' is a silent no-op — a stopped stack needs 'up'.
      echo "Everything is down — the stack is probably just stopped. Start it: ./kingo up"
    else
      echo "Something is down. Try: ./kingo restart   (details: ./kingo logs)"
    fi
  fi
}

