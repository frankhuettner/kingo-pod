# ── smoke: rigorous verification (exact codes + stability + bindings + hub) ───
assert_loopback() {
  # Every published port MUST bind to 127.0.0.1 (plan §5). `compose config`
  # renders the normalized config identically for both engines (both use the
  # docker-compose binary), so we assert host_ip there.
  local cfg npub nloop
  cfg="$(compose_all config 2>/dev/null)" || { warn "could not render compose config for the bind-address check"; return 0; }
  if printf '%s\n' "$cfg" | grep -E 'host_ip:' | grep -qvE 'host_ip:[[:space:]]*127\.0\.0\.1'; then
    echo "FAIL: a published port is NOT bound to 127.0.0.1:"
    printf '%s\n' "$cfg" | grep -E 'host_ip:' | grep -vE 'host_ip:[[:space:]]*127\.0\.0\.1'
    return 1
  fi
  npub=$(printf '%s\n' "$cfg" | grep -cE '^[[:space:]]*published:' || true)
  nloop=$(printf '%s\n' "$cfg" | grep -cE 'host_ip:[[:space:]]*127\.0\.0\.1' || true)
  if [ "${npub:-0}" -ne "${nloop:-0}" ]; then
    echo "FAIL: ${npub} published ports but only ${nloop} bound to 127.0.0.1 (some default to 0.0.0.0)"
    return 1
  fi
  # Drift guard: preflight/fixports/doctor only protect ports they know about,
  # and a count-only check would miss a changed number (e.g. the never-probed
  # Qdrant gRPC port) — so compare the values, not the count.
  local tports cports s
  tports=$(for s in "${SERVICE_TABLE[@]}"; do printf '%s\n' "$s" | cut -d'|' -f3; done | sort -n)
  cports=$(printf '%s\n' "$cfg" | grep -E '^[[:space:]]*published:' | grep -oE '[0-9]+' | sort -n)
  if [ "$tports" != "$cports" ]; then
    echo "FAIL: compose.yml's published ports and kingo's SERVICE_TABLE disagree — update SERVICE_TABLE"
    # shellcheck disable=SC2086
    echo "  compose.yml:  " $cports
    # shellcheck disable=SC2086
    echo "  SERVICE_TABLE:" $tports
    return 1
  fi
  return 0
}

assert_stable() {
  echo "Re-checking stability (a crash-looping container flips to 'Restarting' within seconds) ..."
  sleep 20
  if compose ps --format '{{.Name}} {{.Status}}' 2>/dev/null | grep -i 'restart'; then
    compose ps; die "containers are restart-looping"
  fi
  wait_all 3 || { compose ps; die "services flapped after coming up"; }
}

mode_services_expected() { # $1: mode — the compose service names kingo's table puts in it
  local s name rest
  for s in "${SERVICE_TABLE[@]}"; do
    IFS='|' read -r name rest <<<"$s"
    [ "$name" = "Qdrant gRPC" ] && continue
    case " $(service_modes "$name") " in *" $1 "*) compose_name "$name" ;; esac
  done | sort -u | tr '\n' ' '
}
assert_modes() { # compose.yml's profiles and service_modes() must agree, for every mode
  # (a `case` must not sit textually inside $( ): macOS ships bash 3.2)
  local m want got
  neutral_auth
  for m in $MODES; do
    want=$(mode_services_expected "$m")
    got=$(COMPOSE_PROFILES=$m $ENGINE compose config --services 2>/dev/null | sort -u | tr '\n' ' ')
    if [ "$want" != "$got" ]; then
      echo "FAIL: mode '$m' — compose.yml's profiles and kingo's service_modes() disagree"
      echo "  compose.yml: $got"
      echo "  kingo:       $want"
      return 1
    fi
  done
  # compose_all relies on `--profile full` showing EVERY service (see there):
  # a service that lists other modes but not full would be invisible to down,
  # reset, pull and bundle — and this is the only place that would notice.
  want=$(for s in "${SERVICE_TABLE[@]}"; do IFS='|' read -r name rest <<<"$s"; [ "$name" = "Qdrant gRPC" ] || compose_name "$name"; done | sort -u | tr '\n' ' ')
  got=$(mode_services_expected full)
  if [ "$want" != "$got" ]; then
    echo "FAIL: every service must list 'full' in its profiles — compose_all (down, reset, pull, bundle) sees only these: $got"
    return 1
  fi
  return 0
}

cmd_smoke() {
  select_engine; ensure_ready
  echo "Smoke test — mode $KINGO_MODE ($(mode_describe "$KINGO_MODE")); asserting 127.0.0.1 bindings ..."
  assert_loopback || die "port-binding check failed (see plan §5 security)"
  assert_modes || die "mode/profile drift — fix compose.yml or service_modes() in kingo"
  local stray; stray="$(off_running)"
  [ -z "${stray% }" ] || die "running although off in $KINGO_MODE mode: ${stray% } — './kingo up' stops them"
  echo "Waiting for exact health codes ..."
  wait_all 90 || { compose ps; die "services did not all reach their expected codes"; }
  assert_stable
  # A healthy hub is not enough — it must be able to LAUNCH a Lab.
  if service_active JupyterHub; then
    echo "Verifying JupyterHub can launch a Lab ..."
    $ENGINE exec kingo-jupyterhub jupyterhub-singleuser --version >/dev/null || die "hub cannot launch single-user server"
    $ENGINE exec kingo-jupyterhub python3 -c 'import jupyterlab' || die "jupyterlab not importable in the hub image"
    echo "SMOKE OK — all services healthy, stable, loopback-bound, hub can launch Lab."
  else
    echo "SMOKE OK — $KINGO_MODE mode: all its services healthy, stable, loopback-bound."
  fi
}

# ── Host ports: collision detection + automatic remapping ────────────────────
# A port is busy if ANYTHING listens on it — including apps that bind only the
# IPv6 loopback (::1): the browser's 'localhost' often prefers ::1, so those
# collide for real even though 127.0.0.1 looks free.
port_in_use() {
  (exec 3<>"/dev/tcp/127.0.0.1/$1") 2>/dev/null && { exec 3>&- 3<&-; return 0; }
  (exec 3<>"/dev/tcp/::1/$1") 2>/dev/null && { exec 3>&- 3<&-; return 0; }
  return 1
}

# Host ports out of `ps --format '{{.Ports}}'` on stdin, one per line.
# Podman collapses ADJACENT publishes into ONE RANGE mapping
# (127.0.0.1:6333-6334->6333-6334/tcp) — Qdrant is the only service with two
# neighbouring ports, so it was the only one the old ':[0-9]+->' pattern
# dropped. A missed port makes our OWN port look foreign, which is why this
# lives in one place now: both callers below MUST agree on what is published.
published_host_ports() {
  grep -oE ':[0-9]+(-[0-9]+)?->' | sed -e 's/^://' -e 's/->$//' \
    | while IFS=- read -r lo hi; do
        if [ -n "$hi" ]; then seq "$lo" "$hi"; else echo "$lo"; fi
      done | sort -u
}

engine_kingo_ports() { # $1: engine — host ports of its running kingo-* containers
  command -v "$1" >/dev/null 2>&1 || return 0
  "$1" ps --filter name=kingo- --format '{{.Ports}}' 2>/dev/null \
    | published_host_ports || true
}

# ── gvproxy leak healing (macOS podman machine) ──────────────────────────────
# gvproxy — the podman machine's host-side port forwarder — can keep a host
# port LISTENing after its container is long gone (seen live 2026-08-29: 6333
# and 6334 still busy after a clean 'down'). Restarting the machine clears it,
# but that kills every OTHER container the user may run — not acceptable as
# default advice. Instead we talk to gvproxy's own forwarder API and drop
# exactly the orphaned forwards. A forward is PROVABLY orphaned when gvproxy
# still lists it while no running podman container publishes that host port —
# removing it can break nothing (it forwards to nowhere). Every step degrades
# silently (not macOS, no gvproxy, no curl, `podman ps` unreachable, API
# answers differently → do nothing): callers fall through to the normal
# messages, they never depend on this working.

gvproxy_forwarder_socket() { # prints a host-side API socket path, or nothing
  [ "$(uname -s)" = Darwin ] || return 0
  command -v curl >/dev/null 2>&1 || return 0
  local cmdline cand
  cmdline="$(ps ax -o command= 2>/dev/null | grep -m1 '[g]vproxy' || true)"
  [ -n "$cmdline" ] || return 0
  # Candidates = every unix-socket-looking argument of the gvproxy process;
  # probe each until one speaks the forwarder API (vfkit/podman sockets won't).
  for cand in $(printf '%s\n' "$cmdline" | grep -oE '(unix://)?/[^ ]+\.sock' | sed 's#^unix://##' | sort -u); do
    [ -S "$cand" ] || continue
    if curl -sf --max-time 2 --unix-socket "$cand" http://localhost/services/forwarder/all 2>/dev/null | grep -q '"local"'; then
      printf '%s\n' "$cand"; return 0
    fi
  done
  return 0
}

# The API is also always reachable from INSIDE the machine at the gateway IP
# (that is how dynamic port publishing works) — used when no host socket found.
gvproxy_fwd_all() { # prints the JSON list of active forwards, or nothing
  local sock
  sock="$(gvproxy_forwarder_socket)"
  if [ -n "$sock" ]; then
    curl -sf --max-time 3 --unix-socket "$sock" http://localhost/services/forwarder/all 2>/dev/null && return 0
  fi
  podman machine ssh -- curl -sf --max-time 3 http://192.168.127.1/services/forwarder/all 2>/dev/null || true
}

gvproxy_fwd_unexpose() { # $1: exact "local" string, e.g. 127.0.0.1:6333
  local body sock
  body="{\"local\":\"$1\",\"protocol\":\"tcp\"}"
  sock="$(gvproxy_forwarder_socket)"
  if [ -n "$sock" ]; then
    curl -sf --max-time 3 --unix-socket "$sock" -X POST -d "$body" http://localhost/services/forwarder/unexpose >/dev/null 2>&1 && return 0
  fi
  podman machine ssh -- curl -sf --max-time 3 -X POST -d "'$body'" http://192.168.127.1/services/forwarder/unexpose >/dev/null 2>&1
}

release_leaked_forwards() { # $@: host ports — frees provably-orphaned ones, prints them
  [ "$(uname -s)" = Darwin ] || return 0
  command -v podman >/dev/null 2>&1 || return 0
  command -v curl   >/dev/null 2>&1 || return 0
  ps ax -o command= 2>/dev/null | grep -q '[g]vproxy' || return 0
  local live all port l
  # If podman can't even list containers we cannot PROVE a forward is orphaned
  # — touch nothing (dropping a live forward would break a running service).
  live="$(podman ps --format '{{.Ports}}' 2>/dev/null)" || return 0
  # NB: deliberately unfiltered `podman ps` — ANY running container owning the
  # port means hands off, not just kingo's. Same parser as the attribution
  # above, so a range-published port can never look unpublished here.
  live=" $(printf '%s\n' "$live" | published_host_ports | tr '\n' ' ' || true) "
  all="$(gvproxy_fwd_all || true)"
  printf '%s' "$all" | grep -q '"local"' || return 0
  for port in "$@"; do
    case "$live" in *" $port "*) continue ;; esac  # a live container owns it — hands off
    for l in $(printf '%s\n' "$all" | grep -oE '"local":"[^"]*"' | sed 's/"local":"//; s/"$//'); do
      case "$l" in
        *:"$port") gvproxy_fwd_unexpose "$l" && printf '%s\n' "$port" ;;
      esac
    done
  done
  return 0
}

# After a teardown: verify the engine really let go of our ports, free what it
# provably leaked, so the NEXT 'up' doesn't refuse with a phantom collision.
release_after_down() {
  local entry name suffix port rest busy="" freed
  for entry in "${SERVICE_TABLE[@]}"; do
    IFS='|' read -r name suffix port rest <<<"$entry"
    if port_in_use "$port"; then busy="$busy $port"; fi
  done
  [ -n "$busy" ] || return 0
  # shellcheck disable=SC2086
  freed="$(release_leaked_forwards $busy | sort -u | tr '\n' ' ')"
  [ -n "${freed% }" ] || return 0
  echo "(also freed leaked port forwards the engine had not let go of: ${freed})"
}

# Attribute every busy port: held by our own stack under $ENGINE (fine), by
# the Kingo stack under the OTHER engine (refuse — remapping or double-booting
# would be exactly wrong), or by foreign software (fixports moves those).
# Sets: OURS_N, OTHER_ENGINE_N + OTHER_ENGINE, FOREIGN_N + FOREIGN_LIST +
# FOREIGN_PORTS. The probes are pure bash (milliseconds); the engine CLIs are
# only consulted once a port is actually busy, so the everyday all-free start
# never pays for them.
count_busy_ports() {
  FOREIGN_LIST=""; FOREIGN_PORTS=" "; FOREIGN_N=0; OURS_N=0
  FOREIGN_ACTIVE_LIST=""; FOREIGN_ACTIVE_PORTS=" "; FOREIGN_ACTIVE_N=0   # the subset the current mode publishes
  ACTIVE_PORTS_N=0                                                        # how many ports the current mode publishes
  OTHER_ENGINE=""; OTHER_ENGINE_N=0
  local busy="" entry name suffix port rest mine theirs oeng
  for entry in "${SERVICE_TABLE[@]}"; do
    IFS='|' read -r name suffix port rest <<<"$entry"
    service_active "$name" && ACTIVE_PORTS_N=$((ACTIVE_PORTS_N + 1))
    if port_in_use "$port"; then busy="${busy}${port}|${name}"$'\n'; fi
  done
  [ -n "$busy" ] || return 0
  mine=" $(engine_kingo_ports "$ENGINE" | tr '\n' ' ') "
  oeng=docker; [ "$ENGINE" = docker ] && oeng=podman
  theirs=" $(engine_kingo_ports "$oeng" | tr '\n' ' ') "
  while IFS='|' read -r port name; do
    [ -n "$port" ] || continue
    if [[ "$mine" == *" $port "* ]]; then
      OURS_N=$((OURS_N + 1))
    elif [[ "$theirs" == *" $port "* ]]; then
      OTHER_ENGINE_N=$((OTHER_ENGINE_N + 1)); OTHER_ENGINE="$oeng"
    else
      FOREIGN_LIST="${FOREIGN_LIST}  - port $port ($name)"$'\n'
      FOREIGN_PORTS="${FOREIGN_PORTS}${port} "
      FOREIGN_N=$((FOREIGN_N + 1))
      if service_active "$name"; then
        FOREIGN_ACTIVE_LIST="${FOREIGN_ACTIVE_LIST}  - port $port ($name)"$'\n'
        FOREIGN_ACTIVE_PORTS="${FOREIGN_ACTIVE_PORTS}${port} "
        FOREIGN_ACTIVE_N=$((FOREIGN_ACTIVE_N + 1))
      fi
    fi
  done <<<"$busy"
}

# The stack is visibly running under the other engine — say exactly what to do.
other_engine_hint() { # requires count_busy_ports (sets OTHER_ENGINE)
  echo "The Kingo stack is ALREADY RUNNING under your other engine (${OTHER_ENGINE})."
  echo "Nothing is broken — but this command is talking to ${ENGINE}."
  echo "Either keep using it there:   KINGO_ENGINE=${OTHER_ENGINE} ./kingo status"
  echo "or move it over:              KINGO_ENGINE=${OTHER_ENGINE} ./kingo down   then:   ./kingo up"
}

# Fallback when attribution sees nothing: ALL ports busy at once almost always
# means the Kingo stack itself is running but no engine CLI can see it (e.g.
# the other engine is temporarily unreachable) — moving ports would be exactly
# wrong then. "All" = every port the CURRENT MODE publishes (all_active_busy):
# both engines share .env.local, so an invisible copy runs in this very mode
# and holds exactly these ports — abp's four, never the ten of full. (In the
# two-port modes the signature is weaker; that is the price of not remapping
# a live stack.) Deliberately no count in the text: the guides quote this string.
all_active_busy() { [ "$ACTIVE_PORTS_N" -gt 0 ] && [ "$FOREIGN_ACTIVE_N" = "$ACTIVE_PORTS_N" ]; }
all_busy_hint() {
  echo "ALL of Kingo's ports are busy at once — that usually means the Kingo stack"
  echo "is ALREADY RUNNING (possibly under your other container engine)."
  echo "Check with './kingo status' — if services show 'up', everything already works."
}

dup_ports() { # echoes host ports assigned twice (stale .env.local overrides)
  local entry name suffix port rest seen=" "
  for entry in "${SERVICE_TABLE[@]}"; do
    IFS='|' read -r name suffix port rest <<<"$entry"
    case "$seen" in *" $port "*) printf ' %s' "$port" ;; esac
    seen="${seen}${port} "
  done
}

# Fail BEFORE compose prints a cryptic "address already in use" mid-boot.
preflight_ports() {
  local dups; dups="$(dup_ports)"
  [ -z "$dups" ] || die "two services are configured onto the same host port:${dups} — fix the KINGO_PORT_* lines in .env.local"
  count_busy_ports
  if [ "$OTHER_ENGINE_N" -gt 0 ]; then
    other_engine_hint
    die "not starting a second copy"
  fi
  [ "$FOREIGN_N" = 0 ] && return 0   # all free, or busy only by our own containers
  if all_active_busy; then
    all_busy_hint
    die "not starting a second copy"
  fi
  # A busy port this mode does not publish is not our problem today; fixports
  # still moves it (forward-looking, harmless), so mention it once and go on —
  # after dropping what is merely a forward a previous 'down' leaked.
  if [ "$FOREIGN_ACTIVE_N" = 0 ]; then
    # shellcheck disable=SC2086
    if [ -n "$(release_leaked_forwards $FOREIGN_PORTS)" ]; then count_busy_ports; fi
    [ "$FOREIGN_N" = 0 ] && return 0
    echo "(other software uses ports Kingo would need in other modes — fine in $KINGO_MODE mode; './kingo fixports' moves them if you ever want)"
    return 0
  fi
  # Self-heal before complaining: these listeners are sometimes forwards a
  # previous 'down' leaked (see release_leaked_forwards). Only provably-
  # orphaned ones are dropped; real software is never touched.
  # shellcheck disable=SC2086
  if [ -n "$(release_leaked_forwards $FOREIGN_ACTIVE_PORTS)" ]; then
    count_busy_ports
    if [ "$OTHER_ENGINE_N" = 0 ] && [ "$FOREIGN_ACTIVE_N" = 0 ]; then
      echo "(freed port forwards a previous 'down' had leaked — continuing)"
      return 0
    fi
  fi
  echo "Other software on this machine is already using ports Kingo needs:"
  printf '%s' "$FOREIGN_ACTIVE_LIST"
  echo
  echo "Easy fix: run  ./kingo fixports  — it moves Kingo to free ports"
  echo "automatically (your other software is untouched) — then run './kingo up' again."
  echo
  echo "(Seeing this right after './kingo down', and you started nothing new? Then"
  echo "the engine itself may still be holding the ports. Restarting the engine"
  echo "clears such leftovers — but NOTE: that stops ALL your containers, not just"
  echo "Kingo's. Mac: podman machine stop && podman machine start / Windows: run"
  echo "'wsl --shutdown' in Command Prompt, reopen Ubuntu / Docker Desktop: quit"
  echo "and reopen it. Then run './kingo up' again.)"
  die "ports busy — see above"
}

cmd_fixports() {
  select_engine
  count_busy_ports
  # The setup scripts run this unconditionally, so a running stack is a
  # friendly no-op ("safe to re-run"), not an error.
  if [ "$OTHER_ENGINE_N" -gt 0 ]; then
    other_engine_hint
    die "refusing to remap ports the Kingo stack itself is using"
  fi
  if [ "$FOREIGN_N" = 0 ]; then
    if [ "$OURS_N" -gt 0 ]; then
      echo "The Kingo stack is running — its ports are in use by Kingo itself; nothing to fix."
    else
      echo "All of Kingo's ports are free — nothing to change."
    fi
    return 0
  fi
  if all_active_busy; then
    all_busy_hint
    die "refusing to remap all ports"
  fi
  # Track every port the stack will use so a moved port can't land on another.
  local used=" " entry name suffix port rest newport
  for entry in "${SERVICE_TABLE[@]}"; do
    IFS='|' read -r name suffix port rest <<<"$entry"
    used="${used}${port} "
  done
  for entry in "${SERVICE_TABLE[@]}"; do
    IFS='|' read -r name suffix port rest <<<"$entry"
    # Move ONLY foreign-held ports — a port busy under our own (possibly
    # partial) stack is exactly where the service should stay.
    [[ "$FOREIGN_PORTS" == *" $port "* ]] || continue
    newport=$((port + 1))
    while port_in_use "$newport" || [[ "$used" == *" $newport "* ]]; do
      newport=$((newport + 1))
    done
    used="${used}${newport} "
    # .env/.env.local are sourced in order, so the last assignment wins — a
    # plain append is enough (a later re-run may leave a superseded line
    # behind, which is harmless).
    echo "KINGO_PORT_${suffix}=${newport}" >> .env.local
    echo "  $name: port $port is taken by other software → Kingo will use $newport instead"
  done
  echo
  echo "Saved to .env.local (stays out of git; 'kingo update' is unaffected)."
  echo "Your addresses change accordingly — 'kingo credentials' always shows the right ones."
  echo "Now run: ./kingo up"
}

# ── pull: per-image download with retries ────────────────────────────────────
# `compose pull` can sit on one stuck layer forever with zero output (this bit
# CI for hours). Pulling per image shows progress, attributes a hang to a
# single image, and gives each one 3 tries. Used by the setup scripts,
# `kingo update`, and CI.
pull_retry() { # $1: image ref — up to 3 attempts
  local i
  for i in 1 2 3; do
    if $ENGINE pull "$1"; then return 0; fi
    if [ "$i" -lt 3 ]; then warn "pull failed (attempt $i/3): $1 — retrying ..."; fi
  done
  return 1
}

cmd_pull() {
  select_engine; ensure_ready; neutral_auth
  local imgs img ref
  # All pullable images: everything in compose.yml except the locally-built
  # tags (*:local), plus those builds' BASE images from their Dockerfiles.
  imgs="$( { compose_all config --images 2>/dev/null | grep -v ':local$'; \
             awk '/^FROM/{print $2; exit}' jupyterhub/Dockerfile; \
             awk '/^FROM/{print $2; exit}' langflow/Dockerfile; } || true)"
  [ -n "$imgs" ] || die "could not read the image list from compose.yml"
  for img in $imgs; do
    case "$img" in
      *.*/*) ref="$img" ;;            # registry is explicit (quay.io/…)
      *)     ref="docker.io/$img" ;;  # short name — qualify it for podman
    esac
    # Already present (e.g. loaded from a USB bundle) → skip. This keeps
    # `pull` fully offline after `kingo load`. Safe because compose.yml pins
    # exact tags: a version bump changes the tag, which is then missing here
    # and gets pulled. (Checked under both names — engines store loaded
    # images short or fully-qualified depending on who wrote the bundle.)
    if $ENGINE image inspect "$ref" >/dev/null 2>&1 \
       || $ENGINE image inspect "$img" >/dev/null 2>&1; then
      echo "== $ref already present — skipping"
      continue
    fi
    echo "== pulling $ref"
    pull_retry "$ref" || die "could not pull $ref after 3 attempts — check your internet connection (or, if the error above mentions credentials: ./kingo doctor explains), then re-run: ./kingo pull"
  done
  build_missing
  echo "All images present."
}

# The locally-built images (*:local) that do not exist yet — built now, so that
# install day pays for them, never class day. `up` builds only the ACTIVE
# mode's missing build, so an abp install would otherwise meet jupyterhub's
# `pip install` on its first `kingo mode`. Present images are never rebuilt:
# a USB `kingo load` brings the images but no build cache, and a rebuild
# there re-runs every Dockerfile step — offline that fails. (Forced rebuilds
# after a Dockerfile change are `update`'s job.)
local_builds() { # "service image" for every service with a build: — from compose's normalized
                 # config, because `config --images <svc>` also lists the images of its depends_on
  compose_all config 2>/dev/null | awk '
    function flush() { if (svc != "" && b && img != "") print svc, img; svc=""; b=0; img="" }
    /^services:/ { s=1; next }
    s && /^[^ ]/ { flush(); s=0 }
    s && /^  [A-Za-z0-9_.-]+:$/ { flush(); svc=$1; sub(/:$/, "", svc); next }
    s && /^    build:/ { b=1 }
    s && /^    image: / { img=$2 }
    END { flush() }'
}
build_missing() {
  local svc img
  while read -r svc img; do
    [ -n "$svc" ] || continue
    if $ENGINE image inspect "$img" >/dev/null 2>&1; then
      echo "== $img already built — skipping"
      continue
    fi
    echo "== building $img (first time: downloads its Python packages)"
    compose_all build "$svc"
  done <<EOT
$(local_builds)
EOT
}

# ── bundle/load: offline image transfer (classroom Wi-Fi fallback) ───────────
# The instructor runs `kingo bundle` at home and copies kingo-images-<arch>.tar
# to USB sticks; a student runs `kingo load <path-to-tar>` and `kingo up` then
# starts without downloading anything. The bundle includes the locally-BUILT
# images (jupyterhub, langflow — not just their bases), so the builds need no
# network either.
bundle_images() { # every image the stack needs, one per line — every mode's
  { compose_all config --images 2>/dev/null; \
    awk '/^FROM/{print $2; exit}' jupyterhub/Dockerfile; \
    awk '/^FROM/{print $2; exit}' langflow/Dockerfile; } || true
}

# Docker-style architecture of THIS machine (amd64 / arm64). A bundle is
# single-arch — `save` writes only the local image blobs, which match the host
# — so an arm64 stick will NOT run on an amd64 laptop (and vice versa). Used to
# name bundles and to guard `load`. Macs (Apple Silicon) = arm64; Windows PCs
# and Intel Macs = amd64.
host_docker_arch() {
  case "$(uname -m)" in
    x86_64|amd64)  echo amd64 ;;
    aarch64|arm64) echo arm64 ;;
    *)             uname -m ;;
  esac
}

# docker-archive — what `save` writes, and the only format a student's
# `docker load` accepts — CANNOT carry zstd-compressed layers. n8n publishes
# zstd for every 2.x tag on BOTH architectures, so `save` died a third of the
# way in and left a TRUNCATED tar that still looked like a finished bundle.
# Converting to gzip/v2s2 leaves the image ID untouched (it is computed from
# the UNcompressed diffIDs), so nothing else in the stack notices. Neither
# `podman save` nor a direct `skopeo copy --format v2s2` can do it — the only
# route is out through the `dir` transport, recompressing on the way.
normalize_for_docker_archive() { # $@: images — rewrites the zstd ones in place
  local img id need="" tmp
  # DETECTING zstd needs skopeo just as much as converting does, so without it
  # we can only say so and let verify_bundle be the backstop. (Do not "fix"
  # this by dying here when skopeo is missing: a store whose images are all
  # gzip bundles perfectly well without it — measured on the arm64 Mac,
  # 2026-08-29, 11/11 images, no skopeo installed.) Under Docker the
  # containers-storage probe finds nothing either; verify_bundle covers that.
  if ! command -v skopeo >/dev/null 2>&1; then
    warn "skopeo is not installed, so images using zstd layers (which a bundle cannot carry) cannot be detected or converted.
   Nothing is wrong yet — the check after writing will catch it. If the bundle
   comes out incomplete, install skopeo and re-run:
     Mac:        brew install skopeo
     Linux/WSL:  sudo apt install -y skopeo"
    return 0
  fi
  for img in "$@"; do
    id="$($ENGINE image inspect "$img" --format '{{.Id}}' 2>/dev/null || true)"
    [ -n "$id" ] || continue
    skopeo inspect --raw "containers-storage:@$id" 2>/dev/null \
      | grep -q 'tar+zstd' && need="$need $img"
  done
  [ -n "$need" ] || return 0
  tmp="$(mktemp -d)"
  for img in $need; do
    echo "== converting $img to gzip (zstd cannot go into a bundle)"
    id="$($ENGINE image inspect "$img" --format '{{.Id}}')"
    rm -rf "$tmp/layers"
    skopeo copy --dest-compress --dest-compress-format gzip \
      "containers-storage:@$id" "dir:$tmp/layers" >/dev/null \
      || { rm -rf "$tmp"; die "could not decompress $img for bundling"; }
    skopeo copy --format v2s2 "dir:$tmp/layers" "containers-storage:$img" >/dev/null \
      || { rm -rf "$tmp"; die "could not re-compress $img for bundling"; }
  done
  rm -rf "$tmp"
}

# Every image the bundle MUST contain, as it appears in the tar's manifest.
# podman writes short names fully qualified (docker.io/library/postgres:16),
# so compare on a normalised form or a complete bundle looks incomplete.
norm_image_name() { sed -e 's#^docker\.io/##' -e 's#^library/##' -e 's#^localhost/##'; }

# The failure this guards against was silent: `save` stopped at the first
# unsupported image, every later one was missing, and the command still
# printed "Bundle written". Never report success without checking.
verify_bundle() { # $1: tar  $2..: images that must be in it
  local tar="$1" img got missing=""
  shift
  got="$(tar -xOf "$tar" manifest.json 2>/dev/null \
    | grep -oE '"RepoTags":\[[^]]*\]' | tr ',' '\n' \
    | grep -oE '[A-Za-z0-9._/-]+:[A-Za-z0-9._-]+' | norm_image_name | sort -u)"
  [ -n "$got" ] || die "$tar holds no readable image manifest — the bundle is unusable"
  for img in "$@"; do
    printf '%s\n' "$got" | grep -qxF "$(printf '%s' "$img" | norm_image_name)" \
      || missing="$missing
  - $img"
  done
  [ -z "$missing" ] || die "the bundle is INCOMPLETE — these images did not make it in:$missing
   Do not put this tar on a USB stick; it would fail at 'kingo up'.
   Most likely cause: layers 'save' cannot carry (zstd). Install skopeo
   (Mac: brew install skopeo / Linux+WSL: sudo apt install -y skopeo) and
   re-run — bundle then converts them automatically.
   The unusable file is $tar; delete it to free the space."
}

# ── Finding the instructor's USB stick ───────────────────────────────────────
# Students plug the stick in at the moment the guide tells them to use it — by
# then Ubuntu is already open, and WSL2 only auto-mounts removable drives that
# were present when it STARTED. "cp: cannot stat /mnt/e/..." is therefore the
# NORMAL outcome on Windows, not the exception (hit live 2026-08-30), and
# making students look up a drive letter is exactly the kind of step that
# strands people in a classroom. So look for the bundle ourselves, and on WSL
# mount the Windows drives Ubuntu has not picked up yet.
is_wsl() { grep -qi microsoft /proc/version 2>/dev/null; }

bundle_names() { # candidate file names, this machine's architecture first
  printf '%s\n' "kingo-images-$(host_docker_arch).tar" kingo-images.tar
}

find_bundle_in_dirs() { # $@: directories — prints the first bundle found
  local d n
  for d in "$@"; do
    [ -d "$d" ] || continue
    while IFS= read -r n; do
      [ -f "${d%/}/$n" ] && { printf '%s\n' "${d%/}/$n"; return 0; }
    done <<EOF
$(bundle_names)
EOF
  done
  return 1
}

# Where removable media shows up, per platform. Globs are NOT word-split, so a
# volume with a space in its name ("/Volumes/Macintosh HD") stays one argument.
find_bundle_on_media() {
  find_bundle_in_dirs /mnt/*/ /Volumes/*/ /media/*/ /media/*/*/ /run/media/*/*/ 2>/dev/null
}

wsl_mount_windows_drives() { # mount what Windows has but Ubuntu does not
  is_wsl || return 1
  command -v sudo >/dev/null 2>&1 || return 1
  # NEVER prompt for a password here. Most students install from the internet
  # and have no stick at all — stopping THEM at a password question, asked
  # while looking for hardware they do not own, would be far worse than the
  # problem this solves. Inside the setup scripts sudo was just used for apt,
  # so the cached timestamp makes this succeed exactly when it matters.
  sudo -n true >/dev/null 2>&1 || return 1
  local letters l m upper mounted=0
  # Ask Windows which drives exist; fall back to the usual stick letters when
  # interop is off. tr strips CRs and normalises to lowercase.
  letters="$(powershell.exe -NoProfile -Command 'Get-Volume | Where-Object { $_.DriveLetter } | ForEach-Object { $_.DriveLetter }' 2>/dev/null \
    | tr -d '\r' | tr '[:upper:]' '[:lower:]' | tr -cd 'a-z\n')"
  [ -n "$letters" ] || letters="$(printf 'd\ne\nf\ng\nh')"
  for l in $letters; do
    m="/mnt/$l"
    # Already mounted and readable? Leave it alone — never remount /mnt/c.
    [ -d "$m" ] && [ -n "$(ls -A "$m" 2>/dev/null)" ] && continue
    sudo -n mkdir -p "$m" >/dev/null 2>&1 || continue
    upper="$(printf '%s' "$l" | tr '[:lower:]' '[:upper:]')"
    if sudo -n mount -t drvfs "$upper:" "$m" >/dev/null 2>&1; then
      mounted=1
    else
      sudo -n rmdir "$m" >/dev/null 2>&1 || true   # letter does not exist — leave no stray dir
    fi
  done
  [ "$mounted" = 1 ]
}

# The one entry point: this folder → media that is already mounted → (WSL) the
# drives Ubuntu has not mounted yet. Prints a path, or nothing.
discover_bundle() {
  local p
  p="$(find_bundle_in_dirs . 2>/dev/null || true)"
  [ -n "$p" ] && { printf '%s\n' "${p#./}"; return 0; }
  p="$(find_bundle_on_media || true)"
  [ -n "$p" ] && { printf '%s\n' "$p"; return 0; }
  if is_wsl && wsl_mount_windows_drives; then
    p="$(find_bundle_on_media || true)"
    [ -n "$p" ] && { printf '%s\n' "$p"; return 0; }
  fi
  return 1
}

# ── Bundle checksums: the stick is not a trusted channel ─────────────────────
# The blobs INSIDE a bundle are content-addressed (each layer file is named
# after its own sha256), so a tampered layer cannot load — but a whole tar
# swapped for a different, self-consistent one would pass unnoticed. The fix
# is a checksum that does NOT travel on the stick: `bundle` records it here,
# the instructor commits it, and every student gets it over HTTPS via
# git clone / `kingo update`. `load` then refuses a tar that does not match.
BUNDLE_SUMS=bundles.sha256

file_sha256() { # $1: file — prints the hex digest, or nothing if no tool exists
  if command -v sha256sum >/dev/null 2>&1; then sha256sum "$1" | awk '{print $1}'
  elif command -v shasum >/dev/null 2>&1; then shasum -a 256 "$1" | awk '{print $1}'
  elif command -v openssl >/dev/null 2>&1; then openssl dgst -sha256 "$1" | awk '{print $NF}'
  fi
}

record_bundle_sum() { # $1: bundle just written — updates only ITS line
  local sum base
  base="$(basename "$1")"
  sum="$(file_sha256 "$1")"
  if [ -z "$sum" ]; then
    warn "no sha256 tool found — $BUNDLE_SUMS not updated, so students cannot verify this bundle"
    return 0
  fi
  # Keep every OTHER architecture's line: a mixed class ships two tars, built
  # on two different machines, and each build must not wipe the other's entry.
  { [ -f "$BUNDLE_SUMS" ] && awk -v n="$base" '$2 != n' "$BUNDLE_SUMS" || true; } > "$BUNDLE_SUMS.tmp"
  printf '%s  %s\n' "$sum" "$base" >> "$BUNDLE_SUMS.tmp"
  sort -k2,2 "$BUNDLE_SUMS.tmp" > "$BUNDLE_SUMS"
  rm -f "$BUNDLE_SUMS.tmp"
  echo
  echo "Checksum recorded in $BUNDLE_SUMS:"
  echo "  $sum"
  echo "COMMIT AND PUSH $BUNDLE_SUMS now — 'kingo load' checks every stick against"
  echo "it, and students receive it over HTTPS (git), not from the stick itself."
}

# Set by verify_bundle_checksum so record_install_source can report WHAT was
# checked without hashing 14 GB a second time.
BUNDLE_SUM_VALUE=""
BUNDLE_SUM_STATUS="not checked"

verify_bundle_checksum() { # $1: bundle about to be loaded
  local base want got
  base="$(basename "$1")"
  BUNDLE_SUM_STATUS="not verified (this repo has no $BUNDLE_SUMS — run ./kingo update)"
  [ -f "$BUNDLE_SUMS" ] || return 0
  want="$(awk -v n="$base" '$2 == n {print $1; exit}' "$BUNDLE_SUMS" 2>/dev/null || true)"
  if [ -z "$want" ]; then
    BUNDLE_SUM_STATUS="not verified (no entry for $base in $BUNDLE_SUMS)"
    warn "$BUNDLE_SUMS has no entry for $base — loading it unchecked."
    return 0
  fi
  echo "Checking the bundle against the checksum from the class repo (~1 minute) ..."
  got="$(file_sha256 "$1")"
  if [ -z "$got" ]; then
    BUNDLE_SUM_STATUS="not verified (no sha256 tool on this machine)"
    warn "no sha256 tool on this machine — skipping the checksum check"
    return 0
  fi
  [ "$got" = "$want" ] || die "this file does NOT match the class bundle checksum.
   expected: $want
   found:    $got
   Do NOT load it: it is damaged, was copied incompletely, or is not the
   class bundle at all.
   1) If your instructor rebuilt the bundle recently, run './kingo update'
      first — that fetches the new checksum — and try again.
   2) Otherwise copy the tar from the stick again, and tell your instructor.
   You can always install without the stick instead:  ./kingo pull"
  BUNDLE_SUM_VALUE="$got"
  BUNDLE_SUM_STATUS="verified against $BUNDLE_SUMS"
  echo "Checksum OK — this is the class bundle."
}

# ── Where did this machine's images come from? ───────────────────────────────
# In a room of 30 laptops it matters whether one installed off the stick or
# quietly pulled 10 GB over the class Wi-Fi — and after the fact nothing in
# the engine tells you: image IDs are identical either way, and podman's
# "CREATED" is the upstream build date. So `load` leaves a note, and `doctor`
# reads it back. Gitignored (per-machine fact, like .env.local).
INSTALL_SOURCE_FILE=.kingo-install-source

record_install_source() { # $1: bundle that was loaded
  { echo "loaded_at=$(date '+%Y-%m-%d %H:%M:%S%z' 2>/dev/null || date)"
    echo "bundle=$1"
    echo "arch=$(host_docker_arch)"
    echo "sha256=${BUNDLE_SUM_VALUE:-unknown}"
    echo "checksum=${BUNDLE_SUM_STATUS:-not checked}"
  } > "$INSTALL_SOURCE_FILE" 2>/dev/null || true
}

show_install_source() { # one doctor line: stick or internet?
  local at bundle ck
  if [ ! -f "$INSTALL_SOURCE_FILE" ]; then
    # Say what we KNOW: there is no note. Claiming "came from the internet"
    # was wrong for the machine that loaded a stick with a kingo older than
    # the note itself — measured on Frank's laptop, 2026-08-30.
    echo "  [ok] no USB bundle recorded — images came from the internet"
    echo "       (a stick loaded by an older kingo leaves no note either)."
    return 0
  fi
  at="$(awk -F= '/^loaded_at=/{sub(/^loaded_at=/,""); print; exit}' "$INSTALL_SOURCE_FILE" 2>/dev/null || true)"
  bundle="$(awk -F= '/^bundle=/{sub(/^bundle=/,""); print; exit}' "$INSTALL_SOURCE_FILE" 2>/dev/null || true)"
  ck="$(awk -F= '/^checksum=/{sub(/^checksum=/,""); print; exit}' "$INSTALL_SOURCE_FILE" 2>/dev/null || true)"
  # An unverified bundle is not an [ok] — it is the case a TA wants to see.
  case "${ck:-}" in
    verified*) echo "  [ok] images came from a USB bundle: ${bundle:-?}" ;;
    *)         echo "  [??] images came from a USB bundle, checksum unconfirmed: ${bundle:-?}" ;;
  esac
  echo "       loaded $at — checksum ${ck:-unknown}"
}

cmd_bundle() {
  select_engine; ensure_ready
  local out="${1:-kingo-images-$(host_docker_arch).tar}" imgs free_kb
  free_kb=$(df -Pk "$(dirname "$out")" 2>/dev/null | awk 'NR==2{print $4}' || true)
  # The previous bundle stays on disk until the new one verifies (below), so
  # when one is there BOTH have to fit.
  local keep_kb=0
  if [ -f "$out" ]; then
    keep_kb="$(du -k "$out" 2>/dev/null | awk 'NR==1{print $1}')"
    case "$keep_kb" in ''|*[!0-9]*) keep_kb=0 ;; esac
  fi
  case "$free_kb" in
    ''|*[!0-9]*) : ;;
    *) [ "$free_kb" -lt $((15000000 + keep_kb)) ] && warn "less than ~15 GB free where $out will be written (plus room for the $out already there, which is kept until the new one is verified) — the bundle may not fit" ;;
  esac
  # CI hook (issue #5): bundle an explicit short image list instead of the
  # whole stack. A 14 GB bundle does not fit on a GitHub runner, but the
  # zstd-conversion / verify / load chain MUST be exercised on every push —
  # that chain shipped a truncated tar to a USB stick once. Unset for
  # students, and then this branch does not exist as far as they are
  # concerned: the path below is byte-for-byte what it always was.
  if [ -n "${KINGO_BUNDLE_IMAGES:-}" ]; then
    # shellcheck disable=SC2086
    imgs="$(printf '%s\n' ${KINGO_BUNDLE_IMAGES})"
    echo "KINGO_BUNDLE_IMAGES is set — bundling only: $(printf '%s ' $imgs)"
  else
    echo "Making sure every image is present and the local builds exist ..."
    cmd_pull
    compose_all build
    imgs="$(bundle_images)"
  fi
  # shellcheck disable=SC2086
  normalize_for_docker_archive $imgs
  # Write to a .part file and only move it into place once it verifies.
  # `save` REFUSES to write over an existing archive ("docker-archive doesn't
  # support modifying existing images" — a misleading message for what is just
  # a leftover file), but deleting the old bundle up front would destroy a GOOD
  # stick tar every time a re-run fails halfway.
  local part="$out.part"
  rm -f "$part"
  echo "Writing $out (~14 GB — this takes a few minutes) ..."
  case "$ENGINE" in
    # podman needs -m for a multi-image (docker-compatible) archive.
    # shellcheck disable=SC2086
    podman) podman save -m -o "$part" $imgs ;;
    # shellcheck disable=SC2086
    *)      docker save -o "$part" $imgs ;;
  esac
  # shellcheck disable=SC2086
  verify_bundle "$part" $imgs
  mv -f "$part" "$out"
  echo
  echo "Bundle written: $out   (architecture: $(host_docker_arch), $(du -h "$out" | cut -f1), $(printf '%s\n' $imgs | wc -l | tr -d ' ') images)"
  record_bundle_sum "$out"
  echo
  echo "This bundle runs ONLY on $(host_docker_arch) machines"
  echo "  (arm64 = Apple-Silicon Macs;  amd64 = Windows PCs and Intel Macs)."
  echo "For a class with both, build the OTHER arch on a matching machine and"
  echo "put BOTH tars on the same stick — students auto-pick the one for their"
  echo "laptop. A student loads this one with:"
  echo "  ./kingo load /path/to/$out     (then: ./kingo up)"
}

cmd_load() {
  select_engine; ensure_ready
  local in="${1:-}" _hint
  [ -n "$in" ] || in="$(discover_bundle || true)"
  if [ -z "$in" ]; then
    _hint=""
    is_wsl && _hint="
   On Windows the stick sometimes needs mounting first (replace e/E: with its
   drive letter, which Explorer shows):
     sudo mkdir -p /mnt/e && sudo mount -t drvfs E: /mnt/e
   then run this command again."
    die "no USB bundle found — not in this folder, and not on any plugged-in stick.
   Is the stick plugged in? Then just run this again — that is usually all it takes.$_hint
   You can also name the file yourself:
     ./kingo load /path/to/kingo-images-$(host_docker_arch).tar"
  fi
  [ -f "$in" ] || die "bundle file not found: $in   (usage: ./kingo load /path/to/kingo-images-<arch>.tar — on Windows/WSL a USB stick is under /mnt/<letter>/, on Mac under /Volumes/)"
  verify_bundle_checksum "$in"
  echo "Loading images from $in (takes a few minutes) ..."
  $ENGINE load -i "$in"
  # The bundle stores the local builds fully qualified — docker.io/library/…
  # since the builds go through docker-compose (podman build would have said
  # localhost/…). Either way compose looks for the bare kingo-*:local, so make
  # sure that name exists. Short-name resolution usually covers this already;
  # the guard costs nothing and must name what bundles really carry (issue #5).
  local _n
  for _n in kingo-jupyterhub kingo-langflow; do
    $ENGINE tag "docker.io/library/$_n:local" "$_n:local" 2>/dev/null \
      || $ENGINE tag "localhost/$_n:local" "$_n:local" 2>/dev/null || true
  done
  # Bundles are single-arch: loading an amd64 stick on an arm64 machine (or the
  # reverse) "succeeds" here but every service then dies with an exec-format
  # error at `up`. Catch the wrong-stick case now, with a message that names the
  # tar to use — on a one-stick-both-arches stick both are present.
  local want got
  want="$(host_docker_arch)"
  got="$($ENGINE image inspect kingo-jupyterhub:local --format '{{.Architecture}}' 2>/dev/null || true)"
  [ -n "$got" ] || got="$($ENGINE image inspect "$(compose_all config --images 2>/dev/null | head -n1)" --format '{{.Architecture}}' 2>/dev/null || true)"
  if [ -n "$got" ] && [ "$got" != "$want" ]; then
    die "this bundle holds $got images but your machine is $want — you loaded the wrong stick.
   Use the $want tar instead:  kingo-images-$want.tar
   (arm64 = Apple-Silicon Macs;  amd64 = Windows PCs and Intel Macs.)"
  fi
  record_install_source "$in"
  echo "Images loaded. Now run:  ./kingo up   (no download needed)"
}

# ── langflow: manage Python packages inside the Langflow container ───────────
# Thin passthrough to uv (baked into the locally-built image) running inside
# kingo-langflow — real uv syntax, e.g.: ./kingo langflow pip install statsmodels
# Packages the whole class needs belong in langflow/requirements.txt instead:
# they are baked into the image (kingo update) and survive container recreation.
cmd_langflow() {
  select_engine
  if [ $# -eq 0 ]; then
    cat <<'EOF'
usage: ./kingo langflow <uv command ...>     (runs uv inside the Langflow container)

  ./kingo langflow pip install statsmodels      install a package
  ./kingo langflow pip install -U statsmodels   upgrade it
  ./kingo langflow pip uninstall statsmodels    remove it
  ./kingo langflow pip list                     what is installed?

Heads-up: packages installed this way disappear when the container is recreated
(./kingo down + up, or ./kingo update) — just run the install again. Packages the
whole class needs belong in langflow/requirements.txt: those are baked into the
image and survive everything.
EOF
    return 0
  fi
  service_active Langflow \
    || die "Langflow is off in $KINGO_MODE mode — ./kingo mode abp (or full) turns it on"
  [ -n "$($ENGINE ps -q --filter name=kingo-langflow 2>/dev/null)" ] \
    || die "the Langflow container is not running — start the stack first:  ./kingo up"
  $ENGINE exec kingo-langflow sh -c 'command -v uv >/dev/null 2>&1' \
    || die "this Langflow container has no uv yet (image predates the class-packages change) — run:  ./kingo update"
  $ENGINE exec kingo-langflow uv "$@"
}

# ── version: the one line to ask a student for ───────────────────────────────
# VERSION holds the released stack version (semver; same string as the git
# tag). It is a FILE and not `git describe` on purpose: ZIP-era folders have
# no .git, and those are exactly the installs whose age you cannot otherwise
# tell. Never fatal, and never calls select_engine — a student whose engine is
# broken must still be able to report what they are running.
# ── Memory: host, budget, machine ────────────────────────────────────────────
gb()     { awk -v m="$1" 'BEGIN{g=m/1024; if (g==int(g)) printf "%d GB", g; else printf "%.1f GB", g}'; }
gb_num() { awk -v m="$1" 'BEGIN{g=m/1024; if (g==int(g)) printf "%d", g; else printf "%.1f", g}'; }
host_mem_mb() { # RAM of the laptop — on WSL: what Windows gives Ubuntu (half the laptop by default)
  case "$(uname -s)" in
    Darwin) sysctl -n hw.memsize 2>/dev/null | awk '{printf "%d", $1/1048576}' ;;
    *) awk '/^MemTotal/{printf "%d", $2/1024}' /proc/meminfo 2>/dev/null ;;
  esac
}
host_phrase() { # "this Mac has 8 GB" / "Windows gives Ubuntu 3.9 GB"
  local h; h=$(host_mem_mb); [ -n "$h" ] || { echo "this computer"; return; }
  if [ "$(uname -s)" = Darwin ]; then echo "this Mac has $(gb "$h")"
  elif is_wsl; then echo "Windows gives Ubuntu $(gb "$h")"
  else echo "this computer has $(gb "$h")"; fi
}
machine_mem_mb() { # nothing printed = no machine. `|| true`: inspect exits 125 without a machine, and
                   # this is assigned under errexit in `version` and `doctor` — which must never die
  { podman machine inspect --format '{{.Resources.Memory}}' 2>/dev/null || true; } | head -1 | tr -d '[:space:]'
}
podman_mac() { [ "$ENGINE" = podman ] && [ "$(uname -s)" = Darwin ]; }
modes_that_fit() { # $1: MiB — the modes whose floor fits in it, comma-separated (abp first: it is the default)
  local m out=""
  for m in abp full bi langflow n8n; do
    [ "$(mode_floor_mb "$m")" -le "$1" ] && out="${out:+$out, }$m"
  done
  echo "$out"
}
wsl_memory_note() { # Windows: the memory is Windows' own business — name the default, then the modes that fit
  local budget fits
  budget=$(host_mem_mb); fits=$(modes_that_fit "${budget:-0}")
  echo "       Windows lets WSL use up to half of the laptop's memory by default${budget:+ ($(gb "$budget") here)} and takes back what"
  echo "       the containers do not use. kingo leaves that setting alone — the lever is the mode."
  if [ -z "$fits" ]; then echo "       → even the lightest mode, n8n ($(gb "$(mode_floor_mb n8n)")), is more than that — expect it to be slow"
  else case ", $fits, " in
    *", $KINGO_MODE, "*) echo "       → modes that fit: $fits — $KINGO_MODE, the current one, is among them" ;;
    *) echo "       → modes that fit: $fits   (switch with ./kingo mode ${fits%%,*})" ;;
  esac; fi
}
budget_mb() { # memory the containers can use under $ENGINE (nothing printed = unknown)
  local m=""
  case "$ENGINE" in
    podman) if [ "$(uname -s)" = Darwin ]; then m=$(machine_mem_mb); else m=$(host_mem_mb); fi ;;
    docker) m=$(docker info --format '{{.MemTotal}}' 2>/dev/null || true)
            case "$m" in ''|*[!0-9]*) m="" ;; *) m=$((m / 1048576)) ;; esac ;;
  esac
  case "$m" in ''|*[!0-9]*|0) return 0 ;; esac   # 0: `docker info` with the daemon down
  echo "$m"
}
budget_name() {
  case "$ENGINE" in
    podman) if [ "$(uname -s)" = Darwin ]; then echo "the podman machine"; elif is_wsl; then echo "WSL"; else echo "this computer"; fi ;;
    docker) if [ "$(uname -s)" = Darwin ] || is_wsl; then echo "Docker Desktop"; else echo "this computer"; fi ;;
  esac
}
containers_mem() { # "TOTAL_MB|name MB, name MB, ..." of the running kingo-* containers, largest first
  $ENGINE stats --no-stream --format '{{.Name}} {{.MemUsage}}' 2>/dev/null \
    | awk '$1 ~ /^kingo-/ {
        v=$2; u=v; gsub(/[0-9.]/,"",u); gsub(/[^0-9.]/,"",v)
        if (u=="GiB"||u=="GB") v*=1024; else if (u=="KiB"||u=="kB"||u=="KB") v/=1024; else if (u=="B") v/=1048576
        n=$1; sub(/^kingo-/,"",n); printf "%d %s\n", v, n }' \
    | sort -rn | awk '{t+=$1; l=l (l?", ":"") $2 " " $1} END{printf "%d|%s", t, l}'
}
memory_advice() { # $1: MiB the mode wants — how to get there on this setup
  local want=$1
  if podman_mac; then
    echo "       → ./kingo memory $(gb_num "$want")   (resizes the podman machine; stops ALL containers on this Mac for a minute)"
  elif is_wsl; then
    # Both engines (Docker Desktop's WSL 2 backend is sized by Windows too). No .wslconfig recipe, deliberately:
    # on an 8 GB laptop a higher ceiling only starves Windows, so the mode is the lever (Frank's call, 2026-09-05).
    wsl_memory_note
  elif [ "$ENGINE" = docker ] && [ "$(uname -s)" = Darwin ]; then
    echo "       → Docker Desktop → Settings → Resources → Memory → $(gb "$want") → Apply & restart (that stops ALL your containers)"
  else
    echo "       → this computer has too little memory for $KINGO_MODE mode — a lighter one: ./kingo mode"
  fi
}
mem_report() { # doctor / memory: budget vs the mode's need, then live use
  local budget host floor target label total list
  budget=$(budget_mb); host=$(host_mem_mb)
  floor=$(mode_floor_mb "$KINGO_MODE"); target=$(mode_cap_mb "$KINGO_MODE"); label=$(budget_name)
  if [ -z "$budget" ]; then
    echo "  [??] memory: could not read how much memory $ENGINE has"
  elif [ "$budget" -ge "$floor" ]; then
    echo "  [ok] memory: $label gives containers ${budget} MB; $KINGO_MODE mode wants $(gb "$floor") or more ($(host_phrase))"
  else
    echo "  [!!] memory: $label gives containers only ${budget} MB, but $KINGO_MODE mode wants $(gb "$floor") or more ($(host_phrase))"
    if podman_mac && [ "$budget" -ge "$target" ]; then   # the machine already has all this Mac can spare
      echo "       → this Mac cannot spare more (macOS keeps 3 GB) — a lighter mode: ./kingo mode   (abp wants $(gb "$(mode_floor_mb abp)"))"
    else
      memory_advice "$target"
    fi
  fi
  if podman_mac && [ -n "$budget" ] && [ -n "$host" ] && [ "$host" -le 8192 ] && [ "$budget" -gt "$target" ] && [ -z "${KINGO_MEMORY_MB:-}" ]; then
    echo "  [!!] the podman machine still has ${budget} MB although $KINGO_MODE mode needs only $(gb "$target") — on this $(gb "$host") Mac the rest is better left to macOS"
    echo "       → ./kingo memory $(gb_num "$target")   (stops ALL containers on this Mac for a minute)"
  fi
  IFS='|' read -r total list <<<"$(containers_mem)"
  if [ -n "$list" ]; then echo "       in use right now: ${total} MB ($list)"
  elif [ -n "$( { $ENGINE ps -q --filter name=kingo- 2>/dev/null || true; } | head -1)" ]; then
    echo "       in use right now: could not read it ($ENGINE stats failed)"   # containers run, stats did not
  else echo "       in use right now: nothing — the stack is down"; fi
}
small_host() { # an 8 GB laptop? (WSL: Windows gives Ubuntu under 5 GB, i.e. an 8 GB laptop at the default split)
  local h; h=$(host_mem_mb); [ -n "$h" ] || return 1
  if [ "$(uname -s)" = Darwin ]; then [ "$h" -le 8192 ]; else [ "$h" -lt 5000 ]; fi
}
small_host_hint() { # one nudge, only where it helps — the end of up / update / doctor
  small_host || return 0
  case "$KINGO_MODE" in
    full|bi)
      echo
      echo "NOTE: $(host_phrase) of memory and runs $KINGO_MODE mode ($(mode_describe "$KINGO_MODE")) — that is why it feels slow."
      echo "      Lighter: ./kingo mode abp   (keeps Langflow, n8n, CloudBeaver and the database; Jupyter, Metabase"
      echo "      and Qdrant go off — ./kingo mode full brings them back; nothing is deleted)" ;;
    abp)
      echo
      echo "NOTE: still slow? $(host_phrase) of memory. One tool at a time needs less:"
      echo "      ./kingo mode langflow ($(gb "$(mode_mem_mb langflow)"))   or   ./kingo mode n8n ($(gb "$(mode_mem_mb n8n)"))" ;;
  esac
}
set_local() { # $1: VAR  $2: value ('' = remove) — rewrite ONE line of .env.local and export it now
  { [ -f .env.local ] && grep -v "^$1=" .env.local || true; } > .env.local.tmp
  [ -n "$2" ] && echo "$1=$2" >> .env.local.tmp
  mv .env.local.tmp .env.local
  if [ -n "$2" ]; then export "$1=$2"; else unset "$1"; fi
}
resize_machine() { # $1: MiB — Podman on a Mac only. Stops ALL containers on the Mac for about a minute.
  local want=$1 cur all others a
  cur=$(machine_mem_mb)
  [ "$cur" = "$want" ] && return 0
  echo "Podman machine: $(gb "$cur") → $(gb "$want")."
  echo "This stops ALL containers on this Mac for about a minute — Kingo comes back by itself."
  if ! all=$(podman ps --format '{{.Names}}' 2>/dev/null); then all="?"; fi
  others=$(printf '%s\n' "$all" | grep -v '^kingo-' | grep -v '^$' || true)
  if [ -n "$others" ]; then
    if [ "$all" = "?" ]; then echo "Could not list the containers on this Mac — there may be others besides Kingo's."
    else echo "Containers that are not Kingo's are running on this Mac:"; printf '%s\n' "$others" | sed 's/^/  - /'; fi
    echo "Resizing the Podman machine stops them too, and they do not restart by themselves."
    read -r -p "Type 'yes' to continue, anything else to keep the current memory: " a || a=""
    [ "$a" = yes ] || { echo "Keeping $(gb "$cur")."; return 1; }
  fi
  podman machine stop >/dev/null 2>&1 || true   # already stopped is fine
  # Never die here: the callers roll back (memory unpins, mode goes on with the
  # old size), and a machine left stopped or at a size it cannot boot with would
  # break every later `up`. So a failed start puts the old size back.
  if ! podman machine set --memory "$want"; then
    warn "could not resize the Podman machine — keeping $(gb "$cur")"
    podman machine start >/dev/null 2>&1 || warn "and it did not start again. Try: podman machine start — then ./kingo up"
    return 1
  fi
  if ! podman machine start >/dev/null; then
    warn "the Podman machine did not start with $(gb "$want") — putting it back to $(gb "$cur")"
    podman machine set --memory "$cur" >/dev/null 2>&1 || true
    podman machine start >/dev/null 2>&1 || warn "and it did not start with $(gb "$cur") either. Try: podman machine start — then ./kingo up"
    return 1
  fi
  echo "Podman machine now has $(gb "$want")."
}
mode_cap_mb() { # mode $1's target, capped on a Mac so that macOS keeps at least 3 GB (a pin is ignored).
                # The ONE sizing rule: setup's `machine init`, doctor's advice and `mode` all use it — two
                # rules made an 8 GB Mac's first `./kingo mode full` resize a machine that was already right.
  local want host
  want=$(mode_mem_mb "$1")
  if [ "$(uname -s)" = Darwin ]; then
    host=$(host_mem_mb)
    if [ -n "$host" ] && [ "$want" -gt $((host - 3072)) ]; then want=$((host - 3072)); fi
  fi
  echo "$want"
}
mode_target_mb() { # what the machine should have in mode $1 on THIS Mac: a pin wins, else the capped target
  if [ -n "${KINGO_MEMORY_MB:-}" ]; then echo "$KINGO_MEMORY_MB"; else mode_cap_mb "$1"; fi
}
mode_memory_step() { # $1: mode — Podman on a Mac resizes the machine; every other setup only warns
  local want floor budget
  want=$(mode_target_mb "$1"); floor=$(mode_floor_mb "$1")
  if podman_mac; then
    if [ "$want" -lt "$floor" ]; then
      if [ -n "${KINGO_MEMORY_MB:-}" ]; then warn "memory is pinned to $(gb "$want") (./kingo memory) but $1 mode wants $(gb "$floor") or more — expect it to be slow"
      else warn "$1 mode wants $(gb "$floor") or more, but this Mac cannot spare that (the machine gets $(gb "$want")) — expect it to be slow; lighter: ./kingo mode"; fi
    fi
    if ! resize_machine "$want"; then   # declined (foreign containers) or failed — both already said so
      echo "$1 mode goes on with the memory the machine has — './kingo memory' shows the effect; './kingo mode $1' later asks again."
    fi
    return 0
  fi
  budget=$(budget_mb)
  if [ -n "$budget" ] && [ "$budget" -lt "$floor" ]; then
    echo "Heads-up: $(budget_name) gives containers ${budget} MB and $1 mode wants $(gb "$floor") or more — it will run, but slowly."
    memory_advice "$(mode_cap_mb "$1")"
    echo "Switching anyway ..."
  fi
}

# ── mode / memory: the two dials students learn ──────────────────────────────
cmd_mode() {
  local target="${1:-}" m
  if [ -z "$target" ]; then
    echo "Mode: $KINGO_MODE — $(mode_describe "$KINGO_MODE")"
    [ -n "$(off_services)" ] && echo "Off:  $(off_services)"
    echo
    echo "Modes (and the container memory each one wants):"
    for m in $MODES; do printf '  %-9s %-7s %s\n' "$m" "$(gb "$(mode_mem_mb "$m")")" "$(mode_describe "$m")"; done
    echo
    echo "Switch with: ./kingo mode <name>   — nothing is deleted, every mode keeps your data."
    return 0
  fi
  case " $MODES " in *" $target "*) ;; *) die "unknown mode '$target' — the modes are: $MODES" ;; esac
  [ "$MODE_FROM_ENV" = 1 ] && die "KINGO_MODE is set in your shell environment (to '$KINGO_MODE') and would override what this command writes. Run:  unset KINGO_MODE  — then try again."
  select_engine; ensure_ready
  if [ "$target" = "$KINGO_MODE" ] && { ! podman_mac || [ "$(machine_mem_mb)" = "$(mode_target_mb "$target")" ]; }; then
    echo "Already in $target mode ($(mode_describe "$target")) — nothing to change."
    cmd_up
    return 0
  fi
  # 1. Everything the target needs must be local BEFORE anything changes, so a
  #    failed download can never leave a half-switched stack. pull is
  #    mode-agnostic and builds only MISSING local images (build_missing), so
  #    this is normally a few seconds of "already present" — never a rebuild,
  #    which on a USB install (images, no build cache) would need the network.
  echo "Checking that every image for $target mode is present ..."
  cmd_pull
  #    The same for its ports: a foreign listener on a port only the target
  #    publishes is tolerated in the current mode, and `up` would refuse it —
  #    after the stack is down and the machine resized. (A subshell: preflight
  #    judges by KINGO_MODE and may die.) Its messages speak of the target.
  ( KINGO_MODE="$target"; preflight_ports ) \
    || die "not switching to $target mode — fix the ports first (./kingo fixports), then run: ./kingo mode $target"
  # 2. persist  3. down (every service)  4. memory  5. up (the new mode's services)
  set_local KINGO_MODE "$target"
  export COMPOSE_PROFILES="$target"
  echo
  echo "Switching to $target mode ($(mode_describe "$target")) ..."
  cmd_down
  mode_memory_step "$target"
  cmd_up
  echo
  echo "Mode: $target. On: $(mode_describe "$target")."
  [ -n "$(off_services)" ] && echo "Off: $(off_services). Your data is kept — ./kingo mode full brings everything back."
  return 0
}

cmd_memory() {
  local arg="${1:-}" want host floor b
  case "$arg" in
    target) mode_target_mb "$KINGO_MODE"; return 0 ;;   # what setup-mac.sh gives `podman machine init` (no engine needed)
  esac
  select_engine
  case "$arg" in
    '')
      mem_report
      echo
      [ -n "${KINGO_MEMORY_MB:-}" ] && echo "Pinned to $(gb "$KINGO_MEMORY_MB") in .env.local — './kingo memory auto' lets each mode choose again."
      if podman_mac; then
        # Below the floor mem_report has just named the number to type — a second, different example next to it misleads.
        b=$(budget_mb); floor=$(mode_floor_mb "$KINGO_MODE"); host=$(host_mem_mb)
        if [ -z "$b" ] || [ "$b" -ge "$floor" ]; then
          want=$((floor + 1024)); if [ -n "$host" ] && [ "$want" -gt $((host - 3072)) ]; then want=$((host - 3072)); fi
          echo "Change it: ./kingo memory $(gb_num "$want")   (any number of GB; resizes the podman machine — stops ALL containers on this Mac for a minute)"
        fi
      elif is_wsl; then b=$(budget_mb); { [ -n "$b" ] && [ "$b" -lt "$(mode_floor_mb "$KINGO_MODE")" ]; } || wsl_memory_note   # else mem_report said it
      elif [ "$ENGINE" = docker ] && [ "$(uname -s)" = Darwin ]; then echo "Change it in Docker Desktop → Settings → Resources → Memory (Apply & restart stops ALL your containers)."
      else echo "All of this computer's memory is available to the containers — nothing to set."; fi
      return 0 ;;
    auto)
      set_local KINGO_MEMORY_MB ""
      echo "Memory follows the mode again ($KINGO_MODE mode: $(gb "$(mode_cap_mb "$KINGO_MODE")")). Apply it with: ./kingo mode $KINGO_MODE"
      return 0 ;;
  esac
  want=$(awk -v g="$arg" 'BEGIN{ if (g ~ /^[0-9]+(\.[0-9]+)?$/ && g > 0) { if (g > 64) printf "%d", g; else printf "%d", g*1024 } }')
  [ -n "$want" ] || die "say how much, in GB — e.g.:  ./kingo memory 5   (or 4.5)"
  [ "$want" -ge 2048 ] || die "$(gb "$want") is less than any mode can run in — choose at least 2 GB (the lightest mode, n8n, wants $(gb "$(mode_floor_mb n8n)"))"
  if is_wsl; then
    echo "On Windows kingo does not set the containers' memory:"
    wsl_memory_note
    return 0
  fi
  floor=$(mode_floor_mb "$KINGO_MODE"); host=$(host_mem_mb)
  [ "$want" -lt "$floor" ] && warn "$KINGO_MODE mode wants $(gb "$floor") or more — with $(gb "$want") it will be slow or crash under load"
  if [ -n "$host" ] && [ "$want" -gt $((host - 2048)) ]; then
    die "$(gb "$want") would leave this computer ($(gb "$host")) less than 2 GB for itself — choose at most $(gb "$((host - 2048))")"
  fi
  if podman_mac; then
    ensure_ready
    cmd_down
    # Pin only once the machine really has that size: a pin that outlives a
    # failed resize would make every later `mode` aim at the wrong number.
    if ! resize_machine "$want"; then cmd_up; return 1; fi
    set_local KINGO_MEMORY_MB "$want"
    cmd_up
  elif [ "$(uname -s)" = Darwin ]; then
    echo "On this setup kingo cannot change the memory itself — this is how:"
    memory_advice "$want"
  else
    echo "On Linux the containers already share all of this computer's memory ($(gb "$(host_mem_mb)")) — there is no ceiling to set."
    echo "If that is too little for $KINGO_MODE mode, a lighter one helps: ./kingo mode"
  fi
}

kingo_version() {
  if [ -f ./VERSION ]; then
    tr -d ' \t\r\n' < ./VERSION
  else
    printf 'unknown'   # pre-1.0.0 folder, or someone deleted it
  fi
}

cmd_version() {
  local ref eng ver
  echo "kingo-pod $(kingo_version)"
  if [ -d .git ] && command -v git >/dev/null 2>&1; then
    ref="$(git log -1 --date=short --format='%h %ad' 2>/dev/null || true)"
    if [ -n "$ref" ]; then
      [ -n "$(git status --porcelain 2>/dev/null)" ] && ref="$ref (locally modified)"
      echo "  files:  $ref"
    fi
  else
    echo "  files:  installed from a ZIP (no git history in this folder)"
  fi
  for eng in podman docker; do
    command -v "$eng" >/dev/null 2>&1 || continue
    ver="$("$eng" --version 2>/dev/null | head -1)"
    echo "  engine: ${ver:-$eng}${KINGO_ENGINE:+$([ "$KINGO_ENGINE" = "$eng" ] && printf '  (pinned via KINGO_ENGINE)')}"
  done
  echo "  system: $(uname -s) $(uname -m)${WSL_DISTRO_NAME:+  (WSL: $WSL_DISTRO_NAME)}"
  echo "  mode:   $KINGO_MODE ($(mode_describe "$KINGO_MODE"))$([ "$MODE_FROM_ENV" = 1 ] && printf '  (from the shell environment)')"
  local mem; mem="$(host_phrase)"
  if [ "$(uname -s)" = Darwin ] && command -v podman >/dev/null 2>&1; then
    local mm; mm=$(machine_mem_mb); [ -n "$mm" ] && mem="podman machine $(gb "$mm"); $mem"
  fi
  echo "  memory: $mem${KINGO_MEMORY_MB:+  (pinned via ./kingo memory)}"
}

# ── doctor: preflight before setup ───────────────────────────────────────────
cmd_doctor() {
  select_engine
  echo "== kingo doctor =="
  echo "kingo-pod $(kingo_version)"
  echo "Mode: $KINGO_MODE — $(mode_describe "$KINGO_MODE")$([ -n "$(off_services)" ] && printf '   (off: %s)' "$(off_services)")"
  echo "Selected engine: $ENGINE${KINGO_ENGINE:+  (pinned via KINGO_ENGINE)}"
  command -v "$ENGINE" >/dev/null 2>&1 && echo "  [ok] $ENGINE is installed" || echo "  [!!] $ENGINE not on PATH"

  if $ENGINE info >/dev/null 2>&1; then
    echo "  [ok] $ENGINE can run containers"
    # macOS podman: the engine can be fine while the Docker-API socket the
    # compose provider needs is stale (sleep/wake). Surface it — 'up' needs it,
    # 'down' does not (it falls back to the engine CLI).
    if [ "$ENGINE" = podman ] && [ "$(uname -s)" = Darwin ]; then
      if podman compose ls >/dev/null 2>&1; then
        echo "  [ok] the compose provider can reach the Podman machine"
      else
        echo "  [!!] the Podman machine runs, but the Docker-API socket docker-compose needs is not responding."
        echo "       → 'up' can't work until you restart the machine: podman machine stop && podman machine start"
        echo "         (that briefly stops ALL your podman containers). 'down' still works without it."
      fi
    fi
  else
    echo "  [!!] $ENGINE cannot run containers yet"
    [ "$ENGINE" = podman ] && echo "       → the Podman machine is not running. Run setup/setup-mac.sh (Mac) or setup/setup-linux.sh (Linux/WSL)."
    [ "$ENGINE" = docker ] && echo "       → start Docker Desktop and wait until it says 'running'."
  fi

  # kingo's health probes are curl; without it every service reads DOWN.
  command -v curl >/dev/null 2>&1 \
    || echo "  [!!] curl is not installed — kingo cannot check service health. Linux/WSL: sudo apt-get install -y curl"

  # Memory — judged against what the CURRENT MODE needs (measured 2026-09-05
  # under classroom use; the table is next to SERVICE_TABLE), plus live use.
  mem_report

  # A broken Docker credential helper (gcloud with an expired token, ECR, …
  # from another course) breaks even anonymous pulls. kingo neutralizes it on
  # the podman side; under docker the student's own config is in charge.
  if [ "$ENGINE" = docker ]; then
    local store
    store=$(grep -o '"credsStore"[[:space:]]*:[[:space:]]*"[^"]*"' "$HOME/.docker/config.json" 2>/dev/null | cut -d'"' -f4 || true)
    if [ -n "${store:-}" ]; then
      if ! command -v "docker-credential-${store}" >/dev/null 2>&1 \
         || ! "docker-credential-${store}" list >/dev/null 2>&1; then
        echo "  [!!] your Docker credential helper (docker-credential-${store}) is not working."
        echo "       It breaks image downloads even though Kingo's images need NO login."
        echo "       Fix the helper (e.g. 'gcloud auth login') or remove the credsStore"
        echo "       line from ~/.docker/config.json, then retry."
      fi
    fi
  fi

  # Provider guard: warn if podman would fall back to podman-compose.
  if [ "$ENGINE" = podman ] && ! command -v docker-compose >/dev/null 2>&1; then
    echo "  [!!] the docker-compose provider binary was not found on PATH."
    echo "       podman may fall back to podman-compose, which breaks this stack (plan §4)."
    echo "       Mac: brew install docker-compose   Linux/WSL: re-run setup/setup-linux.sh."
  fi

  # Both engines installed? Tell the student which one is in charge.
  if [ "$ENGINE" = podman ] && command -v docker >/dev/null 2>&1; then
    echo "  [ok] Docker is also installed; kingo is using Podman (both work fine)."
    echo "       To switch: run './kingo down', then 'echo KINGO_ENGINE=docker >> .env.local', then './kingo up'."
  fi

  # Stick or Wi-Fi? Only 'load' knows, so it writes it down (see above).
  show_install_source

  # Two services on the same host port (stale .env.local override)?
  local dups; dups="$(dup_ports)"
  [ -z "$dups" ] || echo "  [!!] two services are configured onto the same host port:${dups} — fix the KINGO_PORT_* lines in .env.local"

  # Port collisions, attributed per port.
  count_busy_ports
  if [ "$OTHER_ENGINE_N" -gt 0 ]; then
    other_engine_hint | sed -e '1s/^/  [??] /' -e '2,$s/^/       /'
  elif all_active_busy; then
    all_busy_hint | sed -e '1s/^/  [??] /' -e '2,$s/^/       /'
  elif [ "$FOREIGN_ACTIVE_N" -gt 0 ]; then
    # Judged like `up` does: only a port the CURRENT MODE publishes is a problem.
    printf '%s' "$FOREIGN_ACTIVE_LIST" | sed 's/^  - /  [!!] busy: /'
    echo "       → run './kingo fixports' to move Kingo to free ports automatically."
    [ "$FOREIGN_N" -gt "$FOREIGN_ACTIVE_N" ] && echo "  [ok] other software also sits on ports of services that are off in $KINGO_MODE mode — fixports moves those too."
    [ "$OURS_N" -gt 0 ] && echo "  [ok] the other busy ports belong to the running Kingo stack itself."
  elif [ "$FOREIGN_N" -gt 0 ]; then
    echo "  [ok] other software sits on ports of services that are off in $KINGO_MODE mode — fine today ('./kingo fixports' moves them if you ever want):"
    printf '%s' "$FOREIGN_LIST" | sed 's/^  - /       - /'
    [ "$OURS_N" -gt 0 ] && echo "  [ok] the other busy ports belong to the running Kingo stack itself."
  elif [ "$OURS_N" -gt 0 ]; then
    echo "  [ok] the Kingo stack is running — its ports are in use by kingo, not a collision."
  else
    echo "  [ok] all ${#SERVICE_TABLE[@]} host ports are free."
  fi
  small_host_hint
  echo "== done =="
}

# ── Dispatch ─────────────────────────────────────────────────────────────────
case "${1:-help}" in
  up|start)          cmd_up ;;
  down|stop)         cmd_down ;;
  status)            cmd_status ;;
  smoke)             cmd_smoke ;;
  doctor)            cmd_doctor ;;
  fixports)          cmd_fixports ;;
  findbundle)        discover_bundle || die "no USB bundle found (is the stick plugged in?)" ;;
  credentials|creds) cmd_credentials ;;
  version|--version) cmd_version ;;
  mcp)               cmd_mcp ;;
  logs)              select_engine; shift; inactive_hint "$@"; compose logs --tail=100 -f "$@" ;;
  restart)           select_engine; ensure_ready; shift; inactive_hint "$@"; compose restart "$@" ;;
  mode)              shift; cmd_mode "${1:-}" ;;
  memory|mem)        shift; cmd_memory "${1:-}" ;;
  pull)              cmd_pull ;;
  langflow)          shift; cmd_langflow "$@" ;;
  bundle)            shift; cmd_bundle "${1:-}" ;;
  load)              shift; cmd_load "${1:-}" ;;
  update)            select_engine; ensure_ready
                     _v_before="$(kingo_version)"
                     # Newest class files first. git installs pull; ZIP
                     # installs (the documented Mac path, no .git) fetch the
                     # repo tarball and sync it over this folder. rsync
                     # replaces files via rename, so overwriting the very
                     # script that is running here is safe (bash keeps
                     # reading its already-open old copy). Never fatal:
                     # offline just means "updating images only".
                     if [ -d .git ]; then
                       if ! git pull --ff-only 2>/dev/null; then
                         if git status --porcelain 2>/dev/null | grep -qv '^??'; then
                           warn "git pull could not update: files in this folder were changed locally — updating images only. To get the newest class files, undo the local edits (git checkout -- .) and re-run: ./kingo update"
                         else
                           warn "git pull failed (no network?) — updating images only"
                         fi
                       fi
                     elif command -v rsync >/dev/null 2>&1; then
                       echo "Fetching the newest class files (this folder came from a ZIP, no git) ..."
                       _tmp="$(mktemp -d)"
                       if curl -fsSL -m 120 https://github.com/frankhuettner/kingo-pod/archive/refs/heads/main.tar.gz \
                            | tar xz -C "$_tmp" --strip-components=1 2>/dev/null; then
                         rsync -a "$_tmp"/ ./
                         echo "Class files updated."
                       else
                         warn "could not download the class files (no network?) — updating images only"
                       fi
                       rm -rf "$_tmp"
                     else
                       warn "this folder was installed from a ZIP (no git) and rsync is missing — updating images only. For new class files, download the ZIP again (see the student guide)."
                     fi
                     # Images and builds for EVERY mode, so a later
                     # './kingo mode full' in class never downloads.
                     cmd_pull
                     compose_all build
                     compose up -d
                     # Name the version students landed on: it is what support
                     # asks for, and it makes "did the update take?" answerable.
                     _v_after="$(kingo_version)"
                     if [ "$_v_before" = "$_v_after" ]; then
                       echo "Stack updated — kingo-pod $_v_after (unchanged; images may still be newer)."
                     else
                       echo "Stack updated — kingo-pod $_v_before → $_v_after."
                     fi
                     small_host_hint ;;
  reset)             select_engine; ensure_ready
                     echo "This DELETES all data (databases, notebooks, workflows) and starts fresh."
                     read -r -p "Type 'yes' to continue: " a
                     if [ "$a" = "yes" ]; then
                       compose_all down -v
                       cmd_up
                     else
                       echo "Cancelled."
                     fi ;;
  help|*)            case "${1:-help}" in
                       help|-h|--help) ;;
                       *) echo "unknown command '$1' — if the guide or an announcement names it, first run:  ./kingo update" >&2; echo >&2 ;;
                     esac
                     cat <<'EOF'
kingo — classroom stack helper (Podman or Docker, no VM)

  kingo up            start everything (+ first-run setup), then show status
  kingo down          stop everything (your data stays)
  kingo status        show which services are up
  kingo smoke         rigorous check: exact health codes, stability, 127.0.0.1
  kingo doctor        preflight: engine ready? memory? ports free?
  kingo fixports      a port is taken (e.g. your own Postgres)? move Kingo
                      to free ports automatically (saved in .env.local)
  kingo credentials   print all URLs and logins
  kingo mode [name]   which services run: full, abp, bi, langflow, n8n
                      (no name: show the current mode and the list)
  kingo memory [GB]   how much memory the containers may use — show it; Podman
                      on a Mac can also set it (kingo memory 5 / 'auto' = by mode)
  kingo version       which stack am I running? (ask students for this)
  kingo mcp           print the Jupyter MCP endpoint + bearer token
  kingo logs [svc]    follow logs (e.g. kingo logs langflow)
  kingo restart [svc] restart everything or one service
  kingo pull          download all images, one at a time with retries
  kingo langflow ...  run uv inside the Langflow container to manage Python
                      packages (e.g. kingo langflow pip install statsmodels)
  kingo bundle [file] save all images into one arch-stamped tar for USB sticks
                      (instructor; default kingo-images-<arch>.tar; records its
                      checksum in bundles.sha256 — commit that file)
  kingo findbundle    print the path of a USB bundle — searches this folder and
                      every stick, and mounts the stick on WSL if needed
  kingo load [file]   load images from a USB bundle — finds the stick by itself
                      when no file is named; 'kingo up' then
                      needs no download (classroom Wi-Fi fallback); refuses a
                      wrong-architecture bundle, and one whose checksum does
                      not match bundles.sha256 from the class repo
  kingo update        get the newest class files + images, rebuild, restart
  kingo reset         wipe all data and start fresh (asks first)

  Engine is auto-detected (Podman preferred). Force one with:
    KINGO_ENGINE=docker kingo up
EOF
                     ;;
esac
