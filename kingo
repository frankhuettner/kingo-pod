cmd_mcp() {
  echo "Jupyter MCP endpoint : http://localhost:${P_MCP}/mcp"
  echo "Bearer token         : ${MCP_TOKEN}"
  echo
  echo "HTTP header for MCP clients:"
  echo "  Authorization: Bearer ${MCP_TOKEN}"
}

# ── smoke: rigorous verification (exact codes + stability + bindings + hub) ───
assert_loopback() {
  # Every published port MUST bind to 127.0.0.1 (plan §5). `compose config`
  # renders the normalized config identically for both engines (both use the
  # docker-compose binary), so we assert host_ip there.
  local cfg npub nloop
  cfg="$(compose config 2>/dev/null)" || { warn "could not render compose config for the bind-address check"; return 0; }
  if printf '%s\n' "$cfg" | grep -E 'host_ip:' | grep -qvE 'host_ip:[[:space:]]*127\.0\.0\.1'; then
    echo "FAIL: a published port is NOT bound to 127.0.0.1:"
    printf '%s\n' "$cfg" | grep -E 'host_ip:' | grep -vE 'host_ip:[[:space:]]*127\.0\.0\.1'
    return 1
  fi
  npub=$(printf '%s\n' "$cfg" | grep -cE '^[[:space:]]*published:' || true)
  nloop=$(printf '%s\n' "$cfg" | grep -cE 'host_ip:[[:space:]]*127\.0\.0\.1' || true)
  if [ "${npub:-0}" -ne "${nloop:-0}" ]; then
    echo "FAIL: ${npub} published ports but only ${nloop} bound to 127.0.0.1 (some default to 0.0.0.0)"
    return 1
  fi
  # Drift guard: preflight/fixports/doctor only protect ports they know about,
  # and a count-only check would miss a changed number (e.g. the never-probed
  # Qdrant gRPC port) — so compare the values, not the count.
  local tports cports s
  tports=$(for s in "${SERVICE_TABLE[@]}"; do printf '%s\n' "$s" | cut -d'|' -f3; done | sort -n)
  cports=$(printf '%s\n' "$cfg" | grep -E '^[[:space:]]*published:' | grep -oE '[0-9]+' | sort -n)
  if [ "$tports" != "$cports" ]; then
    echo "FAIL: compose.yml's published ports and kingo's SERVICE_TABLE disagree — update SERVICE_TABLE"
    # shellcheck disable=SC2086
    echo "  compose.yml:  " $cports
    # shellcheck disable=SC2086
    echo "  SERVICE_TABLE:" $tports
    return 1
  fi
  return 0
}

assert_stable() {
  echo "Re-checking stability (a crash-looping container flips to 'Restarting' within seconds) ..."
  sleep 20
  if compose ps --format '{{.Name}} {{.Status}}' 2>/dev/null | grep -i 'restart'; then
    compose ps; die "containers are restart-looping"
  fi
  wait_all 3 || { compose ps; die "services flapped after coming up"; }
}

cmd_smoke() {
  select_engine; ensure_ready
  echo "Smoke test — asserting 127.0.0.1 bindings ..."
  assert_loopback || die "port-binding check failed (see plan §5 security)"
  echo "Waiting for exact health codes ..."
  wait_all 90 || { compose ps; die "services did not all reach their expected codes"; }
  assert_stable
  # A healthy hub is not enough — it must be able to LAUNCH a Lab.
  echo "Verifying JupyterHub can launch a Lab ..."
  $ENGINE exec kingo-jupyterhub jupyterhub-singleuser --version >/dev/null || die "hub cannot launch single-user server"
  $ENGINE exec kingo-jupyterhub python3 -c 'import jupyterlab' || die "jupyterlab not importable in the hub image"
  echo "SMOKE OK — all services healthy, stable, loopback-bound, hub can launch Lab."
}

# ── Host ports: collision detection + automatic remapping ────────────────────
# A port is busy if ANYTHING listens on it — including apps that bind only the
# IPv6 loopback (::1): the browser's 'localhost' often prefers ::1, so those
# collide for real even though 127.0.0.1 looks free.
port_in_use() {
  (exec 3<>"/dev/tcp/127.0.0.1/$1") 2>/dev/null && { exec 3>&- 3<&-; return 0; }
  (exec 3<>"/dev/tcp/::1/$1") 2>/dev/null && { exec 3>&- 3<&-; return 0; }
  return 1
}

# Host ports out of `ps --format '{{.Ports}}'` on stdin, one per line.
# Podman collapses ADJACENT publishes into ONE RANGE mapping
# (127.0.0.1:6333-6334->6333-6334/tcp) — Qdrant is the only service with two
# neighbouring ports, so it was the only one the old ':[0-9]+->' pattern
# dropped. A missed port makes our OWN port look foreign, which is why this
# lives in one place now: both callers below MUST agree on what is published.
published_host_ports() {
  grep -oE ':[0-9]+(-[0-9]+)?->' | sed -e 's/^://' -e 's/->$//' \
    | while IFS=- read -r lo hi; do
        if [ -n "$hi" ]; then seq "$lo" "$hi"; else echo "$lo"; fi
      done | sort -u
}

engine_kingo_ports() { # $1: engine — host ports of its running kingo-* containers
  command -v "$1" >/dev/null 2>&1 || return 0
  "$1" ps --filter name=kingo- --format '{{.Ports}}' 2>/dev/null \
    | published_host_ports || true
}

# ── gvproxy leak healing (macOS podman machine) ──────────────────────────────
# gvproxy — the podman machine's host-side port forwarder — can keep a host
# port LISTENing after its container is long gone (seen live 2026-08-29: 6333
# and 6334 still busy after a clean 'down'). Restarting the machine clears it,
# but that kills every OTHER container the user may run — not acceptable as
# default advice. Instead we talk to gvproxy's own forwarder API and drop
# exactly the orphaned forwards. A forward is PROVABLY orphaned when gvproxy
# still lists it while no running podman container publishes that host port —
# removing it can break nothing (it forwards to nowhere). Every step degrades
# silently (not macOS, no gvproxy, no curl, `podman ps` unreachable, API
# answers differently → do nothing): callers fall through to the normal
# messages, they never depend on this working.

gvproxy_forwarder_socket() { # prints a host-side API socket path, or nothing
  [ "$(uname -s)" = Darwin ] || return 0
  command -v curl >/dev/null 2>&1 || return 0
  local cmdline cand
  cmdline="$(ps ax -o command= 2>/dev/null | grep -m1 '[g]vproxy' || true)"
  [ -n "$cmdline" ] || return 0
  # Candidates = every unix-socket-looking argument of the gvproxy process;
  # probe each until one speaks the forwarder API (vfkit/podman sockets won't).
  for cand in $(printf '%s\n' "$cmdline" | grep -oE '(unix://)?/[^ ]+\.sock' | sed 's#^unix://##' | sort -u); do
    [ -S "$cand" ] || continue
    if curl -sf --max-time 2 --unix-socket "$cand" http://localhost/services/forwarder/all 2>/dev/null | grep -q '"local"'; then
      printf '%s\n' "$cand"; return 0
    fi
  done
  return 0
}

# The API is also always reachable from INSIDE the machine at the gateway IP
# (that is how dynamic port publishing works) — used when no host socket found.
gvproxy_fwd_all() { # prints the JSON list of active forwards, or nothing
  local sock
  sock="$(gvproxy_forwarder_socket)"
  if [ -n "$sock" ]; then
    curl -sf --max-time 3 --unix-socket "$sock" http://localhost/services/forwarder/all 2>/dev/null && return 0
  fi
  podman machine ssh -- curl -sf --max-time 3 http://192.168.127.1/services/forwarder/all 2>/dev/null || true
}

gvproxy_fwd_unexpose() { # $1: exact "local" string, e.g. 127.0.0.1:6333
  local body sock
  body="{\"local\":\"$1\",\"protocol\":\"tcp\"}"
  sock="$(gvproxy_forwarder_socket)"
  if [ -n "$sock" ]; then
    curl -sf --max-time 3 --unix-socket "$sock" -X POST -d "$body" http://localhost/services/forwarder/unexpose >/dev/null 2>&1 && return 0
  fi
  podman machine ssh -- curl -sf --max-time 3 -X POST -d "'$body'" http://192.168.127.1/services/forwarder/unexpose >/dev/null 2>&1
}

release_leaked_forwards() { # $@: host ports — frees provably-orphaned ones, prints them
  [ "$(uname -s)" = Darwin ] || return 0
  command -v podman >/dev/null 2>&1 || return 0
  command -v curl   >/dev/null 2>&1 || return 0
  ps ax -o command= 2>/dev/null | grep -q '[g]vproxy' || return 0
  local live all port l
  # If podman can't even list containers we cannot PROVE a forward is orphaned
  # — touch nothing (dropping a live forward would break a running service).
  live="$(podman ps --format '{{.Ports}}' 2>/dev/null)" || return 0
  # NB: deliberately unfiltered `podman ps` — ANY running container owning the
  # port means hands off, not just kingo's. Same parser as the attribution
  # above, so a range-published port can never look unpublished here.
  live=" $(printf '%s\n' "$live" | published_host_ports | tr '\n' ' ' || true) "
  all="$(gvproxy_fwd_all || true)"
  printf '%s' "$all" | grep -q '"local"' || return 0
  for port in "$@"; do
    case "$live" in *" $port "*) continue ;; esac  # a live container owns it — hands off
    for l in $(printf '%s\n' "$all" | grep -oE '"local":"[^"]*"' | sed 's/"local":"//; s/"$//'); do
      case "$l" in
        *:"$port") gvproxy_fwd_unexpose "$l" && printf '%s\n' "$port" ;;
      esac
    done
  done
  return 0
}

# After a teardown: verify the engine really let go of our ports, free what it
# provably leaked, so the NEXT 'up' doesn't refuse with a phantom collision.
release_after_down() {
  local entry name suffix port rest busy="" freed
  for entry in "${SERVICE_TABLE[@]}"; do
    IFS='|' read -r name suffix port rest <<<"$entry"
    if port_in_use "$port"; then busy="$busy $port"; fi
  done
  [ -n "$busy" ] || return 0
  # shellcheck disable=SC2086
  freed="$(release_leaked_forwards $busy | sort -u | tr '\n' ' ')"
  [ -n "${freed% }" ] || return 0
  echo "(also freed leaked port forwards the engine had not let go of: ${freed})"
}

# Attribute every busy port: held by our own stack under $ENGINE (fine), by
# the Kingo stack under the OTHER engine (refuse — remapping or double-booting
# would be exactly wrong), or by foreign software (fixports moves those).
# Sets: OURS_N, OTHER_ENGINE_N + OTHER_ENGINE, FOREIGN_N + FOREIGN_LIST +
# FOREIGN_PORTS. The probes are pure bash (milliseconds); the engine CLIs are
# only consulted once a port is actually busy, so the everyday all-free start
# never pays for them.
count_busy_ports() {
  FOREIGN_LIST=""; FOREIGN_PORTS=" "; FOREIGN_N=0; OURS_N=0
  OTHER_ENGINE=""; OTHER_ENGINE_N=0
  local busy="" entry name suffix port rest mine theirs oeng
  for entry in "${SERVICE_TABLE[@]}"; do
    IFS='|' read -r name suffix port rest <<<"$entry"
    if port_in_use "$port"; then busy="${busy}${port}|${name}"$'\n'; fi
  done
  [ -n "$busy" ] || return 0
  mine=" $(engine_kingo_ports "$ENGINE" | tr '\n' ' ') "
  oeng=docker; [ "$ENGINE" = docker ] && oeng=podman
  theirs=" $(engine_kingo_ports "$oeng" | tr '\n' ' ') "
  while IFS='|' read -r port name; do
    [ -n "$port" ] || continue
    if [[ "$mine" == *" $port "* ]]; then
      OURS_N=$((OURS_N + 1))
    elif [[ "$theirs" == *" $port "* ]]; then
      OTHER_ENGINE_N=$((OTHER_ENGINE_N + 1)); OTHER_ENGINE="$oeng"
    else
      FOREIGN_LIST="${FOREIGN_LIST}  - port $port ($name)"$'\n'
      FOREIGN_PORTS="${FOREIGN_PORTS}${port} "
      FOREIGN_N=$((FOREIGN_N + 1))
    fi
  done <<<"$busy"
}

# The stack is visibly running under the other engine — say exactly what to do.
other_engine_hint() { # requires count_busy_ports (sets OTHER_ENGINE)
  echo "The Kingo stack is ALREADY RUNNING under your other engine (${OTHER_ENGINE})."
  echo "Nothing is broken — but this command is talking to ${ENGINE}."
  echo "Either keep using it there:   KINGO_ENGINE=${OTHER_ENGINE} ./kingo status"
  echo "or move it over:              KINGO_ENGINE=${OTHER_ENGINE} ./kingo down   then:   ./kingo up"
}

# Fallback when attribution sees nothing: ALL ports busy at once almost always
# means the Kingo stack itself is running but no engine CLI can see it (e.g.
# the other engine is temporarily unreachable) — moving ports would be exactly
# wrong then. Deliberately no count in the text: the guides quote this string.
all_busy_hint() {
  echo "ALL of Kingo's ports are busy at once — that usually means the Kingo stack"
  echo "is ALREADY RUNNING (possibly under your other container engine)."
  echo "Check with './kingo status' — if services show 'up', everything already works."
}

dup_ports() { # echoes host ports assigned twice (stale .env.local overrides)
  local entry name suffix port rest seen=" "
  for entry in "${SERVICE_TABLE[@]}"; do
    IFS='|' read -r name suffix port rest <<<"$entry"
    case "$seen" in *" $port "*) printf ' %s' "$port" ;; esac
    seen="${seen}${port} "
  done
}

# Fail BEFORE compose prints a cryptic "address already in use" mid-boot.
preflight_ports() {
  local dups; dups="$(dup_ports)"
  [ -z "$dups" ] || die "two services are configured onto the same host port:${dups} — fix the KINGO_PORT_* lines in .env.local"
  count_busy_ports
  if [ "$OTHER_ENGINE_N" -gt 0 ]; then
    other_engine_hint
    die "not starting a second copy"
  fi
  [ "$FOREIGN_N" = 0 ] && return 0   # all free, or busy only by our own containers
  if [ "$FOREIGN_N" = "${#SERVICE_TABLE[@]}" ]; then
    all_busy_hint
    die "not starting a second copy"
  fi
  # Self-heal before complaining: these listeners are sometimes forwards a
  # previous 'down' leaked (see release_leaked_forwards). Only provably-
  # orphaned ones are dropped; real software is never touched.
  # shellcheck disable=SC2086
  if [ -n "$(release_leaked_forwards $FOREIGN_PORTS)" ]; then
    count_busy_ports
    if [ "$OTHER_ENGINE_N" = 0 ] && [ "$FOREIGN_N" = 0 ]; then
      echo "(freed port forwards a previous 'down' had leaked — continuing)"
      return 0
    fi
  fi
  echo "Other software on this machine is already using ports Kingo needs:"
  printf '%s' "$FOREIGN_LIST"
  echo
  echo "Easy fix: run  ./kingo fixports  — it moves Kingo to free ports"
  echo "automatically (your other software is untouched) — then run './kingo up' again."
  echo
  echo "(Seeing this right after './kingo down', and you started nothing new? Then"
  echo "the engine itself may still be holding the ports. Restarting the engine"
  echo "clears such leftovers — but NOTE: that stops ALL your containers, not just"
  echo "Kingo's. Mac: podman machine stop && podman machine start / Windows: run"
  echo "'wsl --shutdown' in Command Prompt, reopen Ubuntu / Docker Desktop: quit"
  echo "and reopen it. Then run './kingo up' again.)"
  die "ports busy — see above"
}

cmd_fixports() {
  select_engine
  count_busy_ports
  # The setup scripts run this unconditionally, so a running stack is a
  # friendly no-op ("safe to re-run"), not an error.
  if [ "$OTHER_ENGINE_N" -gt 0 ]; then
    other_engine_hint
    die "refusing to remap ports the Kingo stack itself is using"
  fi
  if [ "$FOREIGN_N" = 0 ]; then
    if [ "$OURS_N" -gt 0 ]; then
      echo "The Kingo stack is running — its ports are in use by Kingo itself; nothing to fix."
    else
      echo "All of Kingo's ports are free — nothing to change."
    fi
    return 0
  fi
  if [ "$FOREIGN_N" = "${#SERVICE_TABLE[@]}" ]; then
    all_busy_hint
    die "refusing to remap all ports"
  fi
  # Track every port the stack will use so a moved port can't land on another.
  local used=" " entry name suffix port rest newport
  for entry in "${SERVICE_TABLE[@]}"; do
    IFS='|' read -r name suffix port rest <<<"$entry"
    used="${used}${port} "
  done
  for entry in "${SERVICE_TABLE[@]}"; do
    IFS='|' read -r name suffix port rest <<<"$entry"
    # Move ONLY foreign-held ports — a port busy under our own (possibly
    # partial) stack is exactly where the service should stay.
    [[ "$FOREIGN_PORTS" == *" $port "* ]] || continue
    newport=$((port + 1))
    while port_in_use "$newport" || [[ "$used" == *" $newport "* ]]; do
      newport=$((newport + 1))
    done
    used="${used}${newport} "
    # .env/.env.local are sourced in order, so the last assignment wins — a
    # plain append is enough (a later re-run may leave a superseded line
    # behind, which is harmless).
    echo "KINGO_PORT_${suffix}=${newport}" >> .env.local
    echo "  $name: port $port is taken by other software → Kingo will use $newport instead"
  done
  echo
  echo "Saved to .env.local (stays out of git; 'kingo update' is unaffected)."
  echo "Your addresses change accordingly — 'kingo credentials' always shows the right ones."
  echo "Now run: ./kingo up"
}

# ── pull: per-image download with retries ────────────────────────────────────
# `compose pull` can sit on one stuck layer forever with zero output (this bit
# CI for hours). Pulling per image shows progress, attributes a hang to a
# single image, and gives each one 3 tries. Used by the setup scripts,
# `kingo update`, and CI.
pull_retry() { # $1: image ref — up to 3 attempts
  local i
  for i in 1 2 3; do
    if $ENGINE pull "$1"; then return 0; fi
    if [ "$i" -lt 3 ]; then warn "pull failed (attempt $i/3): $1 — retrying ..."; fi
  done
  return 1
}

cmd_pull() {
  select_engine; ensure_ready; neutral_auth
  local imgs img ref
  # All pullable images: everything in compose.yml except the locally-built
  # tags (*:local), plus those builds' BASE images from their Dockerfiles.
  imgs="$( { compose config --images 2>/dev/null | grep -v ':local$'; \
             awk '/^FROM/{print $2; exit}' jupyterhub/Dockerfile; \
             awk '/^FROM/{print $2; exit}' langflow/Dockerfile; } || true)"
  [ -n "$imgs" ] || die "could not read the image list from compose.yml"
  for img in $imgs; do
    case "$img" in
      *.*/*) ref="$img" ;;            # registry is explicit (quay.io/…)
      *)     ref="docker.io/$img" ;;  # short name — qualify it for podman
    esac
    # Already present (e.g. loaded from a USB bundle) → skip. This keeps
    # `pull` fully offline after `kingo load`. Safe because compose.yml pins
    # exact tags: a version bump changes the tag, which is then missing here
    # and gets pulled. (Checked under both names — engines store loaded
    # images short or fully-qualified depending on who wrote the bundle.)
    if $ENGINE image inspect "$ref" >/dev/null 2>&1 \
       || $ENGINE image inspect "$img" >/dev/null 2>&1; then
      echo "== $ref already present — skipping"
      continue
    fi
    echo "== pulling $ref"
    pull_retry "$ref" || die "could not pull $ref after 3 attempts — check your internet connection (or, if the error above mentions credentials: ./kingo doctor explains), then re-run: ./kingo pull"
  done
  echo "All images present."
}

# ── bundle/load: offline image transfer (classroom Wi-Fi fallback) ───────────
# The instructor runs `kingo bundle` at home and copies kingo-images-<arch>.tar
# to USB sticks; a student runs `kingo load <path-to-tar>` and `kingo up` then
# starts without downloading anything. The bundle includes the locally-BUILT
# images (jupyterhub, langflow — not just their bases), so the builds need no
# network either.
bundle_images() { # every image the stack needs, one per line
  { compose config --images 2>/dev/null; \
    awk '/^FROM/{print $2; exit}' jupyterhub/Dockerfile; \
    awk '/^FROM/{print $2; exit}' langflow/Dockerfile; } || true
}

# Docker-style architecture of THIS machine (amd64 / arm64). A bundle is
# single-arch — `save` writes only the local image blobs, which match the host
# — so an arm64 stick will NOT run on an amd64 laptop (and vice versa). Used to
# name bundles and to guard `load`. Macs (Apple Silicon) = arm64; Windows PCs
# and Intel Macs = amd64.
host_docker_arch() {
  case "$(uname -m)" in
    x86_64|amd64)  echo amd64 ;;
    aarch64|arm64) echo arm64 ;;
    *)             uname -m ;;
  esac
}

# docker-archive — what `save` writes, and the only format a student's
# `docker load` accepts — CANNOT carry zstd-compressed layers. n8n publishes
# zstd for every 2.x tag on BOTH architectures, so `save` died a third of the
# way in and left a TRUNCATED tar that still looked like a finished bundle.
# Converting to gzip/v2s2 leaves the image ID untouched (it is computed from
# the UNcompressed diffIDs), so nothing else in the stack notices. Neither
# `podman save` nor a direct `skopeo copy --format v2s2` can do it — the only
# route is out through the `dir` transport, recompressing on the way.
normalize_for_docker_archive() { # $@: images — rewrites the zstd ones in place
  local img id need="" tmp
  # DETECTING zstd needs skopeo just as much as converting does, so without it
  # we can only say so and let verify_bundle be the backstop. (Do not "fix"
  # this by dying here when skopeo is missing: a store whose images are all
  # gzip bundles perfectly well without it — measured on the arm64 Mac,
  # 2026-08-29, 11/11 images, no skopeo installed.) Under Docker the
  # containers-storage probe finds nothing either; verify_bundle covers that.
  if ! command -v skopeo >/dev/null 2>&1; then
    warn "skopeo is not installed, so images using zstd layers (which a bundle cannot carry) cannot be detected or converted.
   Nothing is wrong yet — the check after writing will catch it. If the bundle
   comes out incomplete, install skopeo and re-run:
     Mac:        brew install skopeo
     Linux/WSL:  sudo apt install -y skopeo"
    return 0
  fi
  for img in "$@"; do
    id="$($ENGINE image inspect "$img" --format '{{.Id}}' 2>/dev/null || true)"
    [ -n "$id" ] || continue
    skopeo inspect --raw "containers-storage:@$id" 2>/dev/null \
      | grep -q 'tar+zstd' && need="$need $img"
  done
  [ -n "$need" ] || return 0
  tmp="$(mktemp -d)"
  for img in $need; do
    echo "== converting $img to gzip (zstd cannot go into a bundle)"
    id="$($ENGINE image inspect "$img" --format '{{.Id}}')"
    rm -rf "$tmp/layers"
    skopeo copy --dest-compress --dest-compress-format gzip \
      "containers-storage:@$id" "dir:$tmp/layers" >/dev/null \
      || { rm -rf "$tmp"; die "could not decompress $img for bundling"; }
    skopeo copy --format v2s2 "dir:$tmp/layers" "containers-storage:$img" >/dev/null \
      || { rm -rf "$tmp"; die "could not re-compress $img for bundling"; }
  done
  rm -rf "$tmp"
}

# Every image the bundle MUST contain, as it appears in the tar's manifest.
# podman writes short names fully qualified (docker.io/library/postgres:16),
# so compare on a normalised form or a complete bundle looks incomplete.
norm_image_name() { sed -e 's#^docker\.io/##' -e 's#^library/##' -e 's#^localhost/##'; }

# The failure this guards against was silent: `save` stopped at the first
# unsupported image, every later one was missing, and the command still
# printed "Bundle written". Never report success without checking.
verify_bundle() { # $1: tar  $2..: images that must be in it
  local tar="$1" img got missing=""
  shift
  got="$(tar -xOf "$tar" manifest.json 2>/dev/null \
    | grep -oE '"RepoTags":\[[^]]*\]' | tr ',' '\n' \
    | grep -oE '[A-Za-z0-9._/-]+:[A-Za-z0-9._-]+' | norm_image_name | sort -u)"
  [ -n "$got" ] || die "$tar holds no readable image manifest — the bundle is unusable"
  for img in "$@"; do
    printf '%s\n' "$got" | grep -qxF "$(printf '%s' "$img" | norm_image_name)" \
      || missing="$missing
  - $img"
  done
  [ -z "$missing" ] || die "the bundle is INCOMPLETE — these images did not make it in:$missing
   Do not put this tar on a USB stick; it would fail at 'kingo up'.
   Most likely cause: layers 'save' cannot carry (zstd). Install skopeo
   (Mac: brew install skopeo / Linux+WSL: sudo apt install -y skopeo) and
   re-run — bundle then converts them automatically.
   The unusable file is $tar; delete it to free the space."
}

cmd_bundle() {
  select_engine; ensure_ready
  local out="${1:-kingo-images-$(host_docker_arch).tar}" imgs free_kb
  free_kb=$(df -Pk "$(dirname "$out")" 2>/dev/null | awk 'NR==2{print $4}' || true)
  # The previous bundle stays on disk until the new one verifies (below), so
  # when one is there BOTH have to fit.
  local keep_kb=0
  if [ -f "$out" ]; then
    keep_kb="$(du -k "$out" 2>/dev/null | awk 'NR==1{print $1}')"
    case "$keep_kb" in ''|*[!0-9]*) keep_kb=0 ;; esac
  fi
  case "$free_kb" in
    ''|*[!0-9]*) : ;;
    *) [ "$free_kb" -lt $((15000000 + keep_kb)) ] && warn "less than ~15 GB free where $out will be written (plus room for the $out already there, which is kept until the new one is verified) — the bundle may not fit" ;;
  esac
  echo "Making sure every image is present and the local builds exist ..."
  cmd_pull
  compose build
  imgs="$(bundle_images)"
  # shellcheck disable=SC2086
  normalize_for_docker_archive $imgs
  # Write to a .part file and only move it into place once it verifies.
  # `save` REFUSES to write over an existing archive ("docker-archive doesn't
  # support modifying existing images" — a misleading message for what is just
  # a leftover file), but deleting the old bundle up front would destroy a GOOD
  # stick tar every time a re-run fails halfway.
  local part="$out.part"
  rm -f "$part"
  echo "Writing $out (~13 GB — this takes a few minutes) ..."
  case "$ENGINE" in
    # podman needs -m for a multi-image (docker-compatible) archive.
    # shellcheck disable=SC2086
    podman) podman save -m -o "$part" $imgs ;;
    # shellcheck disable=SC2086
    *)      docker save -o "$part" $imgs ;;
  esac
  # shellcheck disable=SC2086
  verify_bundle "$part" $imgs
  mv -f "$part" "$out"
  echo
  echo "Bundle written: $out   (architecture: $(host_docker_arch), $(du -h "$out" | cut -f1), $(printf '%s\n' $imgs | wc -l | tr -d ' ') images)"
  echo
  echo "This bundle runs ONLY on $(host_docker_arch) machines"
  echo "  (arm64 = Apple-Silicon Macs;  amd64 = Windows PCs and Intel Macs)."
  echo "For a class with both, build the OTHER arch on a matching machine and"
  echo "put BOTH tars on the same stick — students auto-pick the one for their"
  echo "laptop. A student loads this one with:"
  echo "  ./kingo load /path/to/$out     (then: ./kingo up)"
}

cmd_load() {
  select_engine; ensure_ready
  local in="${1:-}"
  if [ -z "$in" ]; then
    for cand in "kingo-images-$(host_docker_arch).tar" kingo-images.tar; do
      [ -f "$cand" ] && in="$cand" && break
    done
    [ -n "$in" ] || in="kingo-images-$(host_docker_arch).tar"
  fi
  [ -f "$in" ] || die "bundle file not found: $in   (usage: ./kingo load /path/to/kingo-images-<arch>.tar — on Windows/WSL a USB stick is under /mnt/<letter>/, on Mac under /Volumes/)"
  echo "Loading images from $in (takes a few minutes) ..."
  $ENGINE load -i "$in"
  # The bundle stores the local builds fully qualified — docker.io/library/…
  # since the builds go through docker-compose (podman build would have said
  # localhost/…). Either way compose looks for the bare kingo-*:local, so make
  # sure that name exists. Short-name resolution usually covers this already;
  # the guard costs nothing and must name what bundles really carry (issue #5).
  local _n
  for _n in kingo-jupyterhub kingo-langflow; do
    $ENGINE tag "docker.io/library/$_n:local" "$_n:local" 2>/dev/null \
      || $ENGINE tag "localhost/$_n:local" "$_n:local" 2>/dev/null || true
  done
  # Bundles are single-arch: loading an amd64 stick on an arm64 machine (or the
  # reverse) "succeeds" here but every service then dies with an exec-format
  # error at `up`. Catch the wrong-stick case now, with a message that names the
  # tar to use — on a one-stick-both-arches stick both are present.
  local want got
  want="$(host_docker_arch)"
  got="$($ENGINE image inspect kingo-jupyterhub:local --format '{{.Architecture}}' 2>/dev/null || true)"
  [ -n "$got" ] || got="$($ENGINE image inspect "$(compose config --images 2>/dev/null | head -n1)" --format '{{.Architecture}}' 2>/dev/null || true)"
  if [ -n "$got" ] && [ "$got" != "$want" ]; then
    die "this bundle holds $got images but your machine is $want — you loaded the wrong stick.
   Use the $want tar instead:  kingo-images-$want.tar
   (arm64 = Apple-Silicon Macs;  amd64 = Windows PCs and Intel Macs.)"
  fi
  echo "Images loaded. Now run:  ./kingo up   (no download needed)"
}

# ── langflow: manage Python packages inside the Langflow container ───────────
# Thin passthrough to uv (baked into the locally-built image) running inside
# kingo-langflow — real uv syntax, e.g.: ./kingo langflow pip install statsmodels
# Packages the whole class needs belong in langflow/requirements.txt instead:
# they are baked into the image (kingo update) and survive container recreation.
cmd_langflow() {
  select_engine
  if [ $# -eq 0 ]; then
    cat <<'EOF'
usage: ./kingo langflow <uv command ...>     (runs uv inside the Langflow container)

  ./kingo langflow pip install statsmodels      install a package
  ./kingo langflow pip install -U statsmodels   upgrade it
  ./kingo langflow pip uninstall statsmodels    remove it
  ./kingo langflow pip list                     what is installed?

Heads-up: packages installed this way disappear when the container is recreated
(./kingo down + up, or ./kingo update) — just run the install again. Packages the
whole class needs belong in langflow/requirements.txt: those are baked into the
image and survive everything.
EOF
    return 0
  fi
  [ -n "$($ENGINE ps -q --filter name=kingo-langflow 2>/dev/null)" ] \
    || die "the Langflow container is not running — start the stack first:  ./kingo up"
  $ENGINE exec kingo-langflow sh -c 'command -v uv >/dev/null 2>&1' \
    || die "this Langflow container has no uv yet (image predates the class-packages change) — run:  ./kingo update"
  $ENGINE exec kingo-langflow uv "$@"
}

# ── doctor: preflight before setup ───────────────────────────────────────────
cmd_doctor() {
  select_engine
  echo "== kingo doctor =="
  echo "Selected engine: $ENGINE${KINGO_ENGINE:+  (pinned via KINGO_ENGINE)}"
  command -v "$ENGINE" >/dev/null 2>&1 && echo "  [ok] $ENGINE is installed" || echo "  [!!] $ENGINE not on PATH"

  if $ENGINE info >/dev/null 2>&1; then
    echo "  [ok] $ENGINE can run containers"
    # macOS podman: the engine can be fine while the Docker-API socket the
    # compose provider needs is stale (sleep/wake). Surface it — 'up' needs it,
    # 'down' does not (it falls back to the engine CLI).
    if [ "$ENGINE" = podman ] && [ "$(uname -s)" = Darwin ]; then
      if podman compose ls >/dev/null 2>&1; then
        echo "  [ok] the compose provider can reach the Podman machine"
      else
        echo "  [!!] the Podman machine runs, but the Docker-API socket docker-compose needs is not responding."
        echo "       → 'up' can't work until you restart the machine: podman machine stop && podman machine start"
        echo "         (that briefly stops ALL your podman containers). 'down' still works without it."
      fi
    fi
  else
    echo "  [!!] $ENGINE cannot run containers yet"
    [ "$ENGINE" = podman ] && echo "       → the Podman machine is not running. Run setup/setup-mac.sh (Mac) or setup/setup-linux.sh (Linux/WSL)."
    [ "$ENGINE" = docker ] && echo "       → start Docker Desktop and wait until it says 'running'."
  fi

  # kingo's health probes are curl; without it every service reads DOWN.
  command -v curl >/dev/null 2>&1 \
    || echo "  [!!] curl is not installed — kingo cannot check service health. Linux/WSL: sudo apt-get install -y curl"

  # Memory — the stack needs ~5 GB wherever the containers actually run
  # (measured 2026-08-21: ~3 GB idle + headroom for notebooks/flows).
  # Threshold 4800, not 5120: a VM given "5 GB" reports slightly less inside.
  local mem=""
  case "$ENGINE" in
    podman) mem=$(podman machine inspect --format '{{.Resources.Memory}}' 2>/dev/null | head -1 || true) ;;             # MB
    docker) mem=$(docker info --format '{{.MemTotal}}' 2>/dev/null || true)
            case "$mem" in ''|*[!0-9]*) mem="" ;; *) mem=$((mem / 1048576)) ;; esac ;;  # bytes → MB
  esac
  case "$mem" in ''|*[!0-9]*) mem="" ;; esac
  if [ -n "$mem" ] && [ "$mem" -gt 0 ]; then
    if [ "$mem" -ge 4800 ]; then
      echo "  [ok] $ENGINE memory: ${mem} MB"
    else
      echo "  [!!] $ENGINE has only ${mem} MB (the stack needs ~5 GB)."
      if [ "$ENGINE" = podman ]; then echo "       → podman machine set --memory 5120   (or re-run setup)"
      else echo "       → Docker Desktop → Settings → Resources → raise Memory to 5 GB+."; fi
    fi
  fi

  # A broken Docker credential helper (gcloud with an expired token, ECR, …
  # from another course) breaks even anonymous pulls. kingo neutralizes it on
  # the podman side; under docker the student's own config is in charge.
  if [ "$ENGINE" = docker ]; then
    local store
    store=$(grep -o '"credsStore"[[:space:]]*:[[:space:]]*"[^"]*"' "$HOME/.docker/config.json" 2>/dev/null | cut -d'"' -f4 || true)
    if [ -n "${store:-}" ]; then
      if ! command -v "docker-credential-${store}" >/dev/null 2>&1 \
         || ! "docker-credential-${store}" list >/dev/null 2>&1; then
        echo "  [!!] your Docker credential helper (docker-credential-${store}) is not working."
        echo "       It breaks image downloads even though Kingo's images need NO login."
        echo "       Fix the helper (e.g. 'gcloud auth login') or remove the credsStore"
        echo "       line from ~/.docker/config.json, then retry."
      fi
    fi
  fi

  # Provider guard: warn if podman would fall back to podman-compose.
  if [ "$ENGINE" = podman ] && ! command -v docker-compose >/dev/null 2>&1; then
    echo "  [!!] the docker-compose provider binary was not found on PATH."
    echo "       podman may fall back to podman-compose, which breaks this stack (plan §4)."
    echo "       Mac: brew install docker-compose   Linux/WSL: re-run setup/setup-linux.sh."
  fi

  # Both engines installed? Tell the student which one is in charge.
  if [ "$ENGINE" = podman ] && command -v docker >/dev/null 2>&1; then
    echo "  [ok] Docker is also installed; kingo is using Podman (both work fine)."
    echo "       To switch: run './kingo down', then 'echo KINGO_ENGINE=docker >> .env.local', then './kingo up'."
  fi

  # Two services on the same host port (stale .env.local override)?
  local dups; dups="$(dup_ports)"
  [ -z "$dups" ] || echo "  [!!] two services are configured onto the same host port:${dups} — fix the KINGO_PORT_* lines in .env.local"

  # Port collisions, attributed per port.
  count_busy_ports
  if [ "$OTHER_ENGINE_N" -gt 0 ]; then
    other_engine_hint | sed -e '1s/^/  [??] /' -e '2,$s/^/       /'
  elif [ "$FOREIGN_N" = "${#SERVICE_TABLE[@]}" ]; then
    all_busy_hint | sed -e '1s/^/  [??] /' -e '2,$s/^/       /'
  elif [ "$FOREIGN_N" -gt 0 ]; then
    printf '%s' "$FOREIGN_LIST" | sed 's/^  - /  [!!] busy: /'
    echo "       → run './kingo fixports' to move Kingo to free ports automatically."
    [ "$OURS_N" -gt 0 ] && echo "  [ok] the other busy ports belong to the running Kingo stack itself."
  elif [ "$OURS_N" -gt 0 ]; then
    echo "  [ok] the Kingo stack is running — its ports are in use by kingo, not a collision."
  else
    echo "  [ok] all ${#SERVICE_TABLE[@]} host ports are free."
  fi
  echo "== done =="
}

# ── Dispatch ─────────────────────────────────────────────────────────────────
case "${1:-help}" in
  up|start)          cmd_up ;;
  down|stop)         cmd_down ;;
  status)            cmd_status ;;
  smoke)             cmd_smoke ;;
  doctor)            cmd_doctor ;;
  fixports)          cmd_fixports ;;
  credentials|creds) cmd_credentials ;;
  mcp)               cmd_mcp ;;
  logs)              select_engine; shift; compose logs --tail=100 -f "$@" ;;
  restart)           select_engine; ensure_ready; shift; compose restart "$@" ;;
  pull)              cmd_pull ;;
  langflow)          shift; cmd_langflow "$@" ;;
  bundle)            shift; cmd_bundle "${1:-}" ;;
  load)              shift; cmd_load "${1:-}" ;;
  update)            select_engine; ensure_ready
                     # Newest class files first. git installs pull; ZIP
                     # installs (the documented Mac path, no .git) fetch the
                     # repo tarball and sync it over this folder. rsync
                     # replaces files via rename, so overwriting the very
                     # script that is running here is safe (bash keeps
                     # reading its already-open old copy). Never fatal:
                     # offline just means "updating images only".
                     if [ -d .git ]; then
                       if ! git pull --ff-only 2>/dev/null; then
                         if git status --porcelain 2>/dev/null | grep -qv '^??'; then
                           warn "git pull could not update: files in this folder were changed locally — updating images only. To get the newest class files, undo the local edits (git checkout -- .) and re-run: ./kingo update"
                         else
                           warn "git pull failed (no network?) — updating images only"
                         fi
                       fi
                     elif command -v rsync >/dev/null 2>&1; then
                       echo "Fetching the newest class files (this folder came from a ZIP, no git) ..."
                       _tmp="$(mktemp -d)"
                       if curl -fsSL -m 120 https://github.com/frankhuettner/kingo-pod/archive/refs/heads/main.tar.gz \
                            | tar xz -C "$_tmp" --strip-components=1 2>/dev/null; then
                         rsync -a "$_tmp"/ ./
                         echo "Class files updated."
                       else
                         warn "could not download the class files (no network?) — updating images only"
                       fi
                       rm -rf "$_tmp"
                     else
                       warn "this folder was installed from a ZIP (no git) and rsync is missing — updating images only. For new class files, download the ZIP again (see the student guide)."
                     fi
                     cmd_pull
                     compose build
                     compose up -d
                     echo "Stack updated." ;;
  reset)             select_engine; ensure_ready
                     echo "This DELETES all data (databases, notebooks, workflows) and starts fresh."
                     read -r -p "Type 'yes' to continue: " a
                     if [ "$a" = "yes" ]; then
                       compose down -v
                       cmd_up
                     else
                       echo "Cancelled."
                     fi ;;
  help|*)            cat <<'EOF'
kingo — classroom stack helper (Podman or Docker, no VM)

  kingo up            start everything (+ first-run setup), then show status
  kingo down          stop everything (your data stays)
  kingo status        show which services are up
  kingo smoke         rigorous check: exact health codes, stability, 127.0.0.1
  kingo doctor        preflight: engine ready? memory? ports free?
  kingo fixports      a port is taken (e.g. your own Postgres)? move Kingo
                      to free ports automatically (saved in .env.local)
  kingo credentials   print all URLs and logins
  kingo mcp           print the Jupyter MCP endpoint + bearer token
  kingo logs [svc]    follow logs (e.g. kingo logs langflow)
  kingo restart [svc] restart everything or one service
  kingo pull          download all images, one at a time with retries
  kingo langflow ...  run uv inside the Langflow container to manage Python
                      packages (e.g. kingo langflow pip install statsmodels)
  kingo bundle [file] save all images into one arch-stamped tar for USB sticks
                      (instructor; default kingo-images-<arch>.tar)
  kingo load [file]   load images from a USB bundle — 'kingo up' then
                      needs no download (classroom Wi-Fi fallback); refuses a
                      wrong-architecture bundle
  kingo update        get the newest class files + images, rebuild, restart
  kingo reset         wipe all data and start fresh (asks first)

  Engine is auto-detected (Podman preferred). Force one with:
    KINGO_ENGINE=docker kingo up
EOF
                     ;;
esac
