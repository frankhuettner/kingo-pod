#!/usr/bin/env bash
# kingo — classroom stack helper (native, engine-agnostic).
# Runs the container stack directly on a laptop with Podman (preferred) or
# Docker. No VM. The ONE CLI for Mac, Linux, and Windows-inside-WSL2.
# Engine is auto-detected (override with KINGO_ENGINE).
set -euo pipefail

KINGO_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}" 2>/dev/null || echo "${BASH_SOURCE[0]}")")" && pwd)"
cd "$KINGO_DIR"

# .env holds the shared classroom defaults (committed). .env.local holds
# per-machine overrides — engine pin, moved ports — written by the setup
# scripts and 'kingo fixports'. It is gitignored, so students never edit the
# committed .env and 'kingo update' can always git pull cleanly.
#
# Self-heal Windows line endings / a UTF-8 BOM in .env.local first: editing it
# with Notepad over \\wsl$ adds both, and a single stray \r inside a value
# breaks the engine name, every port probe, and compose itself.
if [ -f ./.env.local ] && LC_ALL=C grep -qE $'\r|\xef\xbb\xbf' ./.env.local 2>/dev/null; then
  tr -d '\r' < ./.env.local | LC_ALL=C sed $'1s/^\xef\xbb\xbf//' > ./.env.local.clean
  mv ./.env.local.clean ./.env.local
fi
# Any KINGO_* variable given on the command line still beats both files.
_cli_overrides="$(env | LC_ALL=C grep -E '^KINGO_[A-Z0-9_]+=' || true)"
# shellcheck disable=SC1091
set -a; source ./.env; [ -f ./.env.local ] && source ./.env.local; set +a
if [ -n "$_cli_overrides" ]; then
  while IFS= read -r _kv; do export "$_kv"; done <<<"$_cli_overrides"
fi

# Effective host ports (defaults match the guides; overridable via KINGO_PORT_*).
P_LANGFLOW=${KINGO_PORT_LANGFLOW:-7860}
P_N8N=${KINGO_PORT_N8N:-5678}
P_JUPYTERLAB=${KINGO_PORT_JUPYTERLAB:-8888}
P_JUPYTERHUB=${KINGO_PORT_JUPYTERHUB:-8000}
P_MCP=${KINGO_PORT_MCP:-4040}
P_METABASE=${KINGO_PORT_METABASE:-3000}
P_CLOUDBEAVER=${KINGO_PORT_CLOUDBEAVER:-8978}
P_QDRANT=${KINGO_PORT_QDRANT:-6333}
P_QDRANT_GRPC=${KINGO_PORT_QDRANT_GRPC:-6334}
P_POSTGRES=${KINGO_PORT_POSTGRES:-5432}

die()  { echo "ERROR: $*" >&2; exit 1; }
warn() { echo "WARN: $*" >&2; }

# Catch a typo'd engine name in .env.local (or the environment) up front —
# otherwise it only surfaces deep inside ensure_ready, and doctor would
# happily report on a nonsense engine.
case "${KINGO_ENGINE:-}" in
  ''|podman|docker) ;;
  *) die "KINGO_ENGINE is '$KINGO_ENGINE' — it must be 'podman' or 'docker'. Check .env.local (or your shell environment)." ;;
esac

# ── Engine detection ─────────────────────────────────────────────────────────
# Order (per plan §4): $KINGO_ENGINE override → podman (usable or startable) →
# docker → podman as last resort (so the error points at podman setup).
ENGINE=""
select_engine() {
  if [ -n "${KINGO_ENGINE:-}" ]; then ENGINE="$KINGO_ENGINE"; return; fi
  if command -v podman >/dev/null 2>&1; then
    if podman info >/dev/null 2>&1; then ENGINE=podman; return; fi
    if podman machine list -q 2>/dev/null | grep -q .; then ENGINE=podman; return; fi
  fi
  if command -v docker >/dev/null 2>&1; then ENGINE=docker; return; fi
  if command -v podman >/dev/null 2>&1; then ENGINE=podman; return; fi
  die "No container engine found. Install Podman (recommended) or Docker Desktop — see docs/STUDENT-GUIDE-*.md."
}

# Make sure the engine can actually run containers (start podman machine if it
# exists but is stopped; tell the user to run setup if there is no machine).
ensure_ready() {
  case "$ENGINE" in
    podman)
      # The provider guard is not optional: without the docker-compose binary,
      # `podman compose` silently falls back to podman-compose, which breaks
      # this stack (plan §4).
      command -v docker-compose >/dev/null 2>&1 \
        || die "the docker-compose provider binary is missing — podman would fall back to podman-compose, which breaks this stack. Mac: brew install docker-compose. Linux/WSL: re-run setup/setup-linux.sh."
      podman info >/dev/null 2>&1 && return 0
      if podman machine list -q 2>/dev/null | grep -q .; then
        echo "Starting the Podman machine (this takes a few seconds) ..."
        podman machine start >/dev/null 2>&1 || true
      fi
      podman info >/dev/null 2>&1 && return 0
      die "Podman has no ready machine. Run the setup script once: setup/setup-mac.sh (Mac) or setup/setup-linux.sh (Linux, or inside WSL2 Ubuntu on Windows)."
      ;;
    docker)
      docker info >/dev/null 2>&1 \
        || die "Docker is installed but not running. Open Docker Desktop, wait until it says 'running', then try again."
      docker compose version >/dev/null 2>&1 \
        || die "Docker is running but has no Compose plugin ('docker compose'). Install Docker Desktop, or the docker-compose-plugin package on native Linux."
      return 0
      ;;
    *) die "Unknown engine '$ENGINE' (KINGO_ENGINE must be 'podman' or 'docker')." ;;
  esac
}

# One wrapper every verb goes through: `podman compose ...` or `docker compose ...`.
compose() { $ENGINE compose "$@"; }

# ── The service table: the ONE list every command derives from ───────────────
# DisplayName|ENV_SUFFIX|host port|health path|expected codes
#   suffix → the KINGO_PORT_<suffix> override (port already reflects overrides)
#   path 'tcp' → plain TCP probe;  path '-' → port-only (no health/status row)
# Health codes are the source of truth (plan §8): 4040/mcp answering 401
# without the bearer token IS healthy. Exact codes only — "any answer counts"
# once passed while a service was crash-looping. `kingo smoke` asserts this
# table matches compose.yml's published ports, so they cannot drift silently.
SERVICE_TABLE=(
  "JupyterLab|JUPYTERLAB|${P_JUPYTERLAB}|/api|200"
  "JupyterHub|JUPYTERHUB|${P_JUPYTERHUB}|/hub/api|200"
  "Jupyter MCP|MCP|${P_MCP}|/mcp|401"
  "Langflow|LANGFLOW|${P_LANGFLOW}|/health|200"
  "n8n|N8N|${P_N8N}|/healthz|200"
  "Metabase|METABASE|${P_METABASE}|/api/health|200"
  "CloudBeaver|CLOUDBEAVER|${P_CLOUDBEAVER}|/|200|301|302"
  "Qdrant|QDRANT|${P_QDRANT}|/readyz|200"
  "Qdrant gRPC|QDRANT_GRPC|${P_QDRANT_GRPC}|-|-"
  "PostgreSQL|POSTGRES|${P_POSTGRES}|tcp|-"
)

check() { # port path [want] -> 0 if the expected code(s) match
  local port="$1" path="$2" want="${3:-200}" code
  if [ "$path" = "tcp" ]; then
    (exec 3<>"/dev/tcp/127.0.0.1/$port") 2>/dev/null && { exec 3>&- 3<&-; return 0; } || return 1
  fi
  code=$(curl -s -o /dev/null -m 3 -w '%{http_code}' "http://127.0.0.1:${port}${path}" 2>/dev/null || echo 000)
  [ "$code" = 000 ] && return 1   # nothing answered (or curl is missing) — never "up"
  echo "$code" | grep -qE "^(${want})$"
}

wait_all() { # $1 = max attempts (10s apart)
  local attempt all s name suffix port path want
  for attempt in $(seq 1 "$1"); do
    all=1
    for s in "${SERVICE_TABLE[@]}"; do
      IFS='|' read -r name suffix port path want <<<"$s"
      [ "$path" = "-" ] && continue
      check "$port" "$path" "${want:-200}" || { all=0; break; }
    done
    [ "$all" = 1 ] && return 0
    echo "  waiting for services ($attempt/$1) — last not ready: ${name} ..."
    sleep 10
  done
  return 1
}

# ── First-run initialization (idempotent; absorbed from the old bake.sh) ──────
init_stack() {
  # Starter notebook the MCP server points at.
  $ENGINE exec kingo-jupyterlab bash -lc \
    'mkdir -p work && [ -f work/notebook.ipynb ] || printf "%s" "{\"cells\":[],\"metadata\":{},\"nbformat\":4,\"nbformat_minor\":5}" > work/notebook.ipynb' \
    2>/dev/null || warn "could not create the starter notebook (retry with: kingo up)"
  setup_metabase || warn "Metabase pre-setup skipped (worst case: you click through the wizard once)"
}

# Pre-provision the Metabase admin + classroom DB so students never see the
# setup wizard. Idempotent via the setup-token check; non-fatal on failure.
# JSON is parsed with grep (no python3 dependency on the host).
setup_metabase() {
  local mb="http://127.0.0.1:${P_METABASE}" props token sid
  props=$(curl -s -m 5 "$mb/api/session/properties" || true)
  # Gate on has-user-setup, NOT the setup-token: Metabase keeps a (now useless)
  # setup-token around even after an admin exists, so the token alone would make
  # this re-run the setup call and warn every time.
  echo "$props" | grep -q '"has-user-setup":true' && { echo "  Metabase already initialized."; return 0; }
  token=$(echo "$props" | grep -o '"setup-token":"[^"]*"' | cut -d'"' -f4 || true)
  [ -n "${token:-}" ] || { warn "Metabase not ready for pre-setup yet (skipping; re-run: kingo up)"; return 0; }
  sid=$(curl -s -m 15 -X POST "$mb/api/setup" -H 'Content-Type: application/json' -d "{
      \"token\": \"$token\",
      \"user\": {\"email\": \"$METABASE_ADMIN_EMAIL\", \"password\": \"$KINGO_STRONG_PASSWORD\",
                 \"first_name\": \"Kingo\", \"last_name\": \"Admin\", \"site_name\": \"Kingo Classroom\"},
      \"prefs\": {\"site_name\": \"Kingo Classroom\", \"allow_tracking\": false}
    }" | grep -o '"id":"[^"]*"' | head -1 | cut -d'"' -f4 || true)
  [ -n "${sid:-}" ] || { warn "Metabase setup call did not return a session"; return 0; }
  curl -s -m 15 -X POST "$mb/api/database" -H 'Content-Type: application/json' \
    -H "X-Metabase-Session: $sid" -d "{
      \"engine\": \"postgres\", \"name\": \"Classroom (PostgreSQL)\",
      \"details\": {\"host\": \"postgres\", \"port\": 5432, \"dbname\": \"classroom\",
                    \"user\": \"$KINGO_USER\", \"password\": \"$KINGO_PASSWORD\", \"ssl\": false}
    }" >/dev/null 2>&1 || warn "could not add the classroom DB to Metabase"
  echo "  Metabase admin + classroom DB provisioned."
}

# ── Commands ─────────────────────────────────────────────────────────────────
cmd_up() {
  select_engine; ensure_ready
  preflight_ports
  echo "Engine: $ENGINE. Starting the Kingo stack ..."
  # `up` builds the local jupyterhub image only if it's missing (first run);
  # use `kingo update` to force a rebuild after changing the Dockerfile.
  compose up -d
  echo "Waiting for all services to become healthy (first run pulls ~10 GB — be patient) ..."
  wait_all 90 || { echo; compose ps; die "not all services came up. See: ./kingo logs"; }
  echo "All services healthy. Running first-run setup ..."
  init_stack
  echo
  cmd_status
  echo
  echo "Ready. Run 'kingo credentials' for all URLs and logins."
}

cmd_down() { select_engine; compose down; }

cmd_status() {
  select_engine
  local all_up=1 any_up=0 s name suffix port path want st
  printf '%-14s %-8s %s\n' "SERVICE" "STATUS" "URL"
  for s in "${SERVICE_TABLE[@]}"; do
    IFS='|' read -r name suffix port path want <<<"$s"
    [ "$path" = "-" ] && continue
    # status is lenient (any answer = up); smoke enforces exact codes.
    if [ "$path" = "tcp" ]; then
      if check "$port" tcp; then st="up"; any_up=1; else st="DOWN"; all_up=0; fi
      printf '%-14s %-8s localhost:%s\n' "$name" "$st" "$port"
    else
      if check "$port" "$path" '[0-9]{3}'; then st="up"; any_up=1; else st="DOWN"; all_up=0; fi
      printf '%-14s %-8s http://localhost:%s\n' "$name" "$st" "$port"
    fi
  done
  if [ "$all_up" != 1 ]; then
    echo
    if [ "$any_up" = 0 ]; then
      # 'restart' after 'down' is a silent no-op — a stopped stack needs 'up'.
      echo "Everything is down — the stack is probably just stopped. Start it: ./kingo up"
    else
      echo "Something is down. Try: ./kingo restart   (details: ./kingo logs)"
    fi
  fi
}

cmd_credentials() {
  cat <<EOF
Service        URL                                      Login
-------        ---                                      -----
JupyterLab     http://localhost:${P_JUPYTERLAB}                    no login required
JupyterHub     http://localhost:${P_JUPYTERHUB}                    any username / ${KINGO_PASSWORD}
Jupyter MCP    http://localhost:${P_MCP}/mcp                Bearer token: ${MCP_TOKEN}
Langflow       http://localhost:${P_LANGFLOW}                    auto-login (classroom instance)
n8n            http://localhost:${P_N8N}                    create an account on first visit
Metabase       http://localhost:${P_METABASE}                    ${METABASE_ADMIN_EMAIL} / ${KINGO_STRONG_PASSWORD}
CloudBeaver    http://localhost:${P_CLOUDBEAVER}                    ${KINGO_USER} / ${KINGO_STRONG_PASSWORD}
Qdrant         http://localhost:${P_QDRANT}/dashboard          no login required
PostgreSQL     localhost:${P_POSTGRES}                          ${KINGO_USER} / ${KINGO_PASSWORD}  (db: classroom)

MCP clients (Claude Desktop/Code, Cursor): point at http://localhost:${P_MCP}/mcp
  with header  Authorization: Bearer ${MCP_TOKEN}
OpenCode (AI coding) runs natively on your laptop — install it separately (see
  the student guide), then run 'opencode' in a terminal. Keys: opencode auth login.
EOF
}

cmd_mcp() {
  echo "Jupyter MCP endpoint : http://localhost:${P_MCP}/mcp"
  echo "Bearer token         : ${MCP_TOKEN}"
  echo
  echo "HTTP header for MCP clients:"
  echo "  Authorization: Bearer ${MCP_TOKEN}"
}

# ── smoke: rigorous verification (exact codes + stability + bindings + hub) ───
assert_loopback() {
  # Every published port MUST bind to 127.0.0.1 (plan §5). `compose config`
  # renders the normalized config identically for both engines (both use the
  # docker-compose binary), so we assert host_ip there.
  local cfg npub nloop
  cfg="$(compose config 2>/dev/null)" || { warn "could not render compose config for the bind-address check"; return 0; }
  if printf '%s\n' "$cfg" | grep -E 'host_ip:' | grep -qvE 'host_ip:[[:space:]]*127\.0\.0\.1'; then
    echo "FAIL: a published port is NOT bound to 127.0.0.1:"
    printf '%s\n' "$cfg" | grep -E 'host_ip:' | grep -vE 'host_ip:[[:space:]]*127\.0\.0\.1'
    return 1
  fi
  npub=$(printf '%s\n' "$cfg" | grep -cE '^[[:space:]]*published:' || true)
  nloop=$(printf '%s\n' "$cfg" | grep -cE 'host_ip:[[:space:]]*127\.0\.0\.1' || true)
  if [ "${npub:-0}" -ne "${nloop:-0}" ]; then
    echo "FAIL: ${npub} published ports but only ${nloop} bound to 127.0.0.1 (some default to 0.0.0.0)"
    return 1
  fi
  # Drift guard: preflight/fixports/doctor only protect ports they know about,
  # and a count-only check would miss a changed number (e.g. the never-probed
  # Qdrant gRPC port) — so compare the values, not the count.
  local tports cports s
  tports=$(for s in "${SERVICE_TABLE[@]}"; do printf '%s\n' "$s" | cut -d'|' -f3; done | sort -n)
  cports=$(printf '%s\n' "$cfg" | grep -E '^[[:space:]]*published:' | grep -oE '[0-9]+' | sort -n)
  if [ "$tports" != "$cports" ]; then
    echo "FAIL: compose.yml's published ports and kingo's SERVICE_TABLE disagree — update SERVICE_TABLE"
    # shellcheck disable=SC2086
    echo "  compose.yml:  " $cports
    # shellcheck disable=SC2086
    echo "  SERVICE_TABLE:" $tports
    return 1
  fi
  return 0
}

assert_stable() {
  echo "Re-checking stability (a crash-looping container flips to 'Restarting' within seconds) ..."
  sleep 20
  if compose ps --format '{{.Name}} {{.Status}}' 2>/dev/null | grep -i 'restart'; then
    compose ps; die "containers are restart-looping"
  fi
  wait_all 3 || { compose ps; die "services flapped after coming up"; }
}

cmd_smoke() {
  select_engine; ensure_ready
  echo "Smoke test — asserting 127.0.0.1 bindings ..."
  assert_loopback || die "port-binding check failed (see plan §5 security)"
  echo "Waiting for exact health codes ..."
  wait_all 90 || { compose ps; die "services did not all reach their expected codes"; }
  assert_stable
  # A healthy hub is not enough — it must be able to LAUNCH a Lab.
  echo "Verifying JupyterHub can launch a Lab ..."
  $ENGINE exec kingo-jupyterhub jupyterhub-singleuser --version >/dev/null || die "hub cannot launch single-user server"
  $ENGINE exec kingo-jupyterhub python3 -c 'import jupyterlab' || die "jupyterlab not importable in the hub image"
  echo "SMOKE OK — all services healthy, stable, loopback-bound, hub can launch Lab."
}

# ── Host ports: collision detection + automatic remapping ────────────────────
# A port is busy if ANYTHING listens on it — including apps that bind only the
# IPv6 loopback (::1): the browser's 'localhost' often prefers ::1, so those
# collide for real even though 127.0.0.1 looks free.
port_in_use() {
  (exec 3<>"/dev/tcp/127.0.0.1/$1") 2>/dev/null && { exec 3>&- 3<&-; return 0; }
  (exec 3<>"/dev/tcp/::1/$1") 2>/dev/null && { exec 3>&- 3<&-; return 0; }
  return 1
}

engine_kingo_ports() { # $1: engine — host ports of its running kingo-* containers
  command -v "$1" >/dev/null 2>&1 || return 0
  "$1" ps --filter name=kingo- --format '{{.Ports}}' 2>/dev/null \
    | grep -oE ':[0-9]+->' | grep -oE '[0-9]+' | sort -u || true
}

# Attribute every busy port: held by our own stack under $ENGINE (fine), by
# the Kingo stack under the OTHER engine (refuse — remapping or double-booting
# would be exactly wrong), or by foreign software (fixports moves those).
# Sets: OURS_N, OTHER_ENGINE_N + OTHER_ENGINE, FOREIGN_N + FOREIGN_LIST +
# FOREIGN_PORTS. The probes are pure bash (milliseconds); the engine CLIs are
# only consulted once a port is actually busy, so the everyday all-free start
# never pays for them.
count_busy_ports() {
  FOREIGN_LIST=""; FOREIGN_PORTS=" "; FOREIGN_N=0; OURS_N=0
  OTHER_ENGINE=""; OTHER_ENGINE_N=0
  local busy="" entry name suffix port rest mine theirs oeng
  for entry in "${SERVICE_TABLE[@]}"; do
    IFS='|' read -r name suffix port rest <<<"$entry"
    if port_in_use "$port"; then busy="${busy}${port}|${name}"$'\n'; fi
  done
  [ -n "$busy" ] || return 0
  mine=" $(engine_kingo_ports "$ENGINE" | tr '\n' ' ') "
  oeng=docker; [ "$ENGINE" = docker ] && oeng=podman
  theirs=" $(engine_kingo_ports "$oeng" | tr '\n' ' ') "
  while IFS='|' read -r port name; do
    [ -n "$port" ] || continue
    if [[ "$mine" == *" $port "* ]]; then
      OURS_N=$((OURS_N + 1))
    elif [[ "$theirs" == *" $port "* ]]; then
      OTHER_ENGINE_N=$((OTHER_ENGINE_N + 1)); OTHER_ENGINE="$oeng"
    else
      FOREIGN_LIST="${FOREIGN_LIST}  - port $port ($name)"$'\n'
      FOREIGN_PORTS="${FOREIGN_PORTS}${port} "
      FOREIGN_N=$((FOREIGN_N + 1))
    fi
  done <<<"$busy"
}

# The stack is visibly running under the other engine — say exactly what to do.
other_engine_hint() { # requires count_busy_ports (sets OTHER_ENGINE)
  echo "The Kingo stack is ALREADY RUNNING under your other engine (${OTHER_ENGINE})."
  echo "Nothing is broken — but this command is talking to ${ENGINE}."
  echo "Either keep using it there:   KINGO_ENGINE=${OTHER_ENGINE} ./kingo status"
  echo "or move it over:              KINGO_ENGINE=${OTHER_ENGINE} ./kingo down   then:   ./kingo up"
}

# Fallback when attribution sees nothing: ALL ports busy at once almost always
# means the Kingo stack itself is running but no engine CLI can see it (e.g.
# the other engine is temporarily unreachable) — moving ports would be exactly
# wrong then. Deliberately no count in the text: the guides quote this string.
all_busy_hint() {
  echo "ALL of Kingo's ports are busy at once — that usually means the Kingo stack"
  echo "is ALREADY RUNNING (possibly under your other container engine)."
  echo "Check with './kingo status' — if services show 'up', everything already works."
}

dup_ports() { # echoes host ports assigned twice (stale .env.local overrides)
  local entry name suffix port rest seen=" "
  for entry in "${SERVICE_TABLE[@]}"; do
    IFS='|' read -r name suffix port rest <<<"$entry"
    case "$seen" in *" $port "*) printf ' %s' "$port" ;; esac
    seen="${seen}${port} "
  done
}

# Fail BEFORE compose prints a cryptic "address already in use" mid-boot.
preflight_ports() {
  local dups; dups="$(dup_ports)"
  [ -z "$dups" ] || die "two services are configured onto the same host port:${dups} — fix the KINGO_PORT_* lines in .env.local"
  count_busy_ports
  if [ "$OTHER_ENGINE_N" -gt 0 ]; then
    other_engine_hint
    die "not starting a second copy"
  fi
  [ "$FOREIGN_N" = 0 ] && return 0   # all free, or busy only by our own containers
  if [ "$FOREIGN_N" = "${#SERVICE_TABLE[@]}" ]; then
    all_busy_hint
    die "not starting a second copy"
  fi
  echo "Other software on this machine is already using ports Kingo needs:"
  printf '%s' "$FOREIGN_LIST"
  echo
  echo "Easy fix: run  ./kingo fixports  — it moves Kingo to free ports"
  echo "automatically (your other software is untouched) — then run './kingo up' again."
  die "ports busy — see above"
}

cmd_fixports() {
  select_engine
  count_busy_ports
  # The setup scripts run this unconditionally, so a running stack is a
  # friendly no-op ("safe to re-run"), not an error.
  if [ "$OTHER_ENGINE_N" -gt 0 ]; then
    other_engine_hint
    die "refusing to remap ports the Kingo stack itself is using"
  fi
  if [ "$FOREIGN_N" = 0 ]; then
    if [ "$OURS_N" -gt 0 ]; then
      echo "The Kingo stack is running — its ports are in use by Kingo itself; nothing to fix."
    else
      echo "All of Kingo's ports are free — nothing to change."
    fi
    return 0
  fi
  if [ "$FOREIGN_N" = "${#SERVICE_TABLE[@]}" ]; then
    all_busy_hint
    die "refusing to remap all ports"
  fi
  # Track every port the stack will use so a moved port can't land on another.
  local used=" " entry name suffix port rest newport
  for entry in "${SERVICE_TABLE[@]}"; do
    IFS='|' read -r name suffix port rest <<<"$entry"
    used="${used}${port} "
  done
  for entry in "${SERVICE_TABLE[@]}"; do
    IFS='|' read -r name suffix port rest <<<"$entry"
    # Move ONLY foreign-held ports — a port busy under our own (possibly
    # partial) stack is exactly where the service should stay.
    [[ "$FOREIGN_PORTS" == *" $port "* ]] || continue
    newport=$((port + 1))
    while port_in_use "$newport" || [[ "$used" == *" $newport "* ]]; do
      newport=$((newport + 1))
    done
    used="${used}${newport} "
    # .env/.env.local are sourced in order, so the last assignment wins — a
    # plain append is enough (a later re-run may leave a superseded line
    # behind, which is harmless).
    echo "KINGO_PORT_${suffix}=${newport}" >> .env.local
    echo "  $name: port $port is taken by other software → Kingo will use $newport instead"
  done
  echo
  echo "Saved to .env.local (stays out of git; 'kingo update' is unaffected)."
  echo "Your addresses change accordingly — 'kingo credentials' always shows the right ones."
  echo "Now run: ./kingo up"
}

# ── pull: per-image download with retries ────────────────────────────────────
# `compose pull` can sit on one stuck layer forever with zero output (this bit
# CI for hours). Pulling per image shows progress, attributes a hang to a
# single image, and gives each one 3 tries. Used by the setup scripts,
# `kingo update`, and CI.
pull_retry() { # $1: image ref — up to 3 attempts
  local i
  for i in 1 2 3; do
    if $ENGINE pull "$1"; then return 0; fi
    if [ "$i" -lt 3 ]; then warn "pull failed (attempt $i/3): $1 — retrying ..."; fi
  done
  return 1
}

cmd_pull() {
  select_engine; ensure_ready
  local imgs img ref
  # All pullable images: everything in compose.yml except the locally-built
  # jupyterhub tag (*:local), plus that build's BASE image from its Dockerfile.
  imgs="$( { compose config --images 2>/dev/null | grep -v ':local$'; \
             awk '/^FROM/{print $2; exit}' jupyterhub/Dockerfile; } || true)"
  [ -n "$imgs" ] || die "could not read the image list from compose.yml"
  for img in $imgs; do
    case "$img" in
      *.*/*) ref="$img" ;;            # registry is explicit (quay.io/…)
      *)     ref="docker.io/$img" ;;  # short name — qualify it for podman
    esac
    echo "== pulling $ref"
    pull_retry "$ref" || die "could not pull $ref after 3 attempts — check your internet connection, then re-run: ./kingo pull"
  done
  echo "All images pulled."
}

# ── doctor: preflight before setup ───────────────────────────────────────────
cmd_doctor() {
  select_engine
  echo "== kingo doctor =="
  echo "Selected engine: $ENGINE${KINGO_ENGINE:+  (pinned via KINGO_ENGINE)}"
  command -v "$ENGINE" >/dev/null 2>&1 && echo "  [ok] $ENGINE is installed" || echo "  [!!] $ENGINE not on PATH"

  if $ENGINE info >/dev/null 2>&1; then
    echo "  [ok] $ENGINE can run containers"
  else
    echo "  [!!] $ENGINE cannot run containers yet"
    [ "$ENGINE" = podman ] && echo "       → the Podman machine is not running. Run setup/setup-mac.sh (Mac) or setup/setup-linux.sh (Linux/WSL)."
    [ "$ENGINE" = docker ] && echo "       → start Docker Desktop and wait until it says 'running'."
  fi

  # kingo's health probes are curl; without it every service reads DOWN.
  command -v curl >/dev/null 2>&1 \
    || echo "  [!!] curl is not installed — kingo cannot check service health. Linux/WSL: sudo apt-get install -y curl"

  # Memory — the stack needs ~6 GB wherever the containers actually run.
  local mem=""
  case "$ENGINE" in
    podman) mem=$(podman machine inspect --format '{{.Resources.Memory}}' 2>/dev/null | head -1 || true) ;;             # MB
    docker) mem=$(docker info --format '{{.MemTotal}}' 2>/dev/null || true)
            case "$mem" in ''|*[!0-9]*) mem="" ;; *) mem=$((mem / 1048576)) ;; esac ;;  # bytes → MB
  esac
  case "$mem" in ''|*[!0-9]*) mem="" ;; esac
  if [ -n "$mem" ] && [ "$mem" -gt 0 ]; then
    if [ "$mem" -ge 5500 ]; then
      echo "  [ok] $ENGINE memory: ${mem} MB"
    else
      echo "  [!!] $ENGINE has only ${mem} MB (the stack needs ~6 GB)."
      if [ "$ENGINE" = podman ]; then echo "       → podman machine set --memory 6144   (or re-run setup)"
      else echo "       → Docker Desktop → Settings → Resources → raise Memory to 6 GB+."; fi
    fi
  fi

  # Provider guard: warn if podman would fall back to podman-compose.
  if [ "$ENGINE" = podman ] && ! command -v docker-compose >/dev/null 2>&1; then
    echo "  [!!] the docker-compose provider binary was not found on PATH."
    echo "       podman may fall back to podman-compose, which breaks this stack (plan §4)."
    echo "       Mac: brew install docker-compose   Linux/WSL: re-run setup/setup-linux.sh."
  fi

  # Both engines installed? Tell the student which one is in charge.
  if [ "$ENGINE" = podman ] && command -v docker >/dev/null 2>&1; then
    echo "  [ok] Docker is also installed; kingo is using Podman (both work fine)."
    echo "       To switch: run './kingo down', then 'echo KINGO_ENGINE=docker >> .env.local', then './kingo up'."
  fi

  # Two services on the same host port (stale .env.local override)?
  local dups; dups="$(dup_ports)"
  [ -z "$dups" ] || echo "  [!!] two services are configured onto the same host port:${dups} — fix the KINGO_PORT_* lines in .env.local"

  # Port collisions, attributed per port.
  count_busy_ports
  if [ "$OTHER_ENGINE_N" -gt 0 ]; then
    other_engine_hint | sed -e '1s/^/  [??] /' -e '2,$s/^/       /'
  elif [ "$FOREIGN_N" = "${#SERVICE_TABLE[@]}" ]; then
    all_busy_hint | sed -e '1s/^/  [??] /' -e '2,$s/^/       /'
  elif [ "$FOREIGN_N" -gt 0 ]; then
    printf '%s' "$FOREIGN_LIST" | sed 's/^  - /  [!!] busy: /'
    echo "       → run './kingo fixports' to move Kingo to free ports automatically."
    [ "$OURS_N" -gt 0 ] && echo "  [ok] the other busy ports belong to the running Kingo stack itself."
  elif [ "$OURS_N" -gt 0 ]; then
    echo "  [ok] the Kingo stack is running — its ports are in use by kingo, not a collision."
  else
    echo "  [ok] all ${#SERVICE_TABLE[@]} host ports are free."
  fi
  echo "== done =="
}

# ── Dispatch ─────────────────────────────────────────────────────────────────
case "${1:-help}" in
  up|start)          cmd_up ;;
  down|stop)         cmd_down ;;
  status)            cmd_status ;;
  smoke)             cmd_smoke ;;
  doctor)            cmd_doctor ;;
  fixports)          cmd_fixports ;;
  credentials|creds) cmd_credentials ;;
  mcp)               cmd_mcp ;;
  logs)              select_engine; shift; compose logs --tail=100 -f "$@" ;;
  restart)           select_engine; ensure_ready; shift; compose restart "$@" ;;
  pull)              cmd_pull ;;
  update)            select_engine; ensure_ready
                     # ZIP installs (the documented Mac path) have no .git —
                     # say so instead of silently skipping the class files.
                     if [ -d .git ]; then
                       git pull --ff-only 2>/dev/null || warn "git pull failed (no network?) — updating images only"
                     else
                       warn "this folder was installed from a ZIP (no git) — updating images only. For new class files, download the ZIP again (see the student guide)."
                     fi
                     cmd_pull
                     compose build
                     compose up -d
                     echo "Stack updated." ;;
  reset)             select_engine; ensure_ready
                     echo "This DELETES all data (databases, notebooks, workflows) and starts fresh."
                     read -r -p "Type 'yes' to continue: " a
                     if [ "$a" = "yes" ]; then
                       compose down -v
                       cmd_up
                     else
                       echo "Cancelled."
                     fi ;;
  help|*)            cat <<'EOF'
kingo — classroom stack helper (Podman or Docker, no VM)

  kingo up            start everything (+ first-run setup), then show status
  kingo down          stop everything (your data stays)
  kingo status        show which services are up
  kingo smoke         rigorous check: exact health codes, stability, 127.0.0.1
  kingo doctor        preflight: engine ready? memory? ports free?
  kingo fixports      a port is taken (e.g. your own Postgres)? move Kingo
                      to free ports automatically (saved in .env.local)
  kingo credentials   print all URLs and logins
  kingo mcp           print the Jupyter MCP endpoint + bearer token
  kingo logs [svc]    follow logs (e.g. kingo logs langflow)
  kingo restart [svc] restart everything or one service
  kingo pull          download all images, one at a time with retries
  kingo update        pull newer images, rebuild, restart
  kingo reset         wipe all data and start fresh (asks first)

  Engine is auto-detected (Podman preferred). Force one with:
    KINGO_ENGINE=docker kingo up
EOF
                     ;;
esac
