# ── Kingo classroom credentials ──────────────────────────────────────────────
# Deliberately simple and identical on every student laptop. Every service is
# published on 127.0.0.1 ONLY (see compose.yml + SECURITY note below), so it is
# reachable only from the student's own machine — these are not secrets.
# Keeping them fixed means your slides always match.
KINGO_USER=student
KINGO_PASSWORD=kingo2026

# Metabase and CloudBeaver enforce password complexity rules:
KINGO_STRONG_PASSWORD=Kingo2026!
METABASE_ADMIN_EMAIL=admin@kingo.local

# Bearer token students paste into MCP clients (printed by `kingo mcp`)
MCP_TOKEN=kingo-mcp-2026

# Fixed across all laptops so exported n8n workflows (incl. credentials) can be
# shared between instructor and students.
# SECURITY: because this key is shared and public, anyone can decrypt a shared
# n8n workflow export — never put a real API key in a workflow you share.
N8N_ENCRYPTION_KEY=kingo-classroom-shared-key-2026
LANGFLOW_SECRET_KEY=kingo-langflow-secret-2026

TZ=Asia/Seoul

# ── Compose profiles (modes) ─────────────────────────────────────────────────
# `kingo` overrides this with the current mode (COMPOSE_PROFILES=<mode>), so it
# is NOT how the mode is chosen — that is `./kingo mode`. It exists for one
# reader: a `kingo` from before modes (v1.0.x) running `./kingo update`. That
# script keeps executing after its own `git pull` and calls compose without
# any profile, which against this compose.yml would see postgres alone and
# still print "Stack updated". With `full` here it sees every service, exactly
# as it did before. Do not remove while any pre-1.1.0 folder may still update.
COMPOSE_PROFILES=full

# ── Host port overrides ──────────────────────────────────────────────────────
# Every service publishes on 127.0.0.1:<port>. If a port is already used by
# other software on your machine (e.g. your own PostgreSQL on 5432), do NOT
# edit this file — run `./kingo fixports`: it finds free ports and writes
# KINGO_PORT_* overrides into `.env.local` (a file next to this one that stays
# out of git, so `kingo update` keeps working). Only the browser URL changes;
# container-to-container routing by service name is unaffected.
# Available override names, with their defaults:
#   KINGO_PORT_LANGFLOW=7860      KINGO_PORT_N8N=5678
#   KINGO_PORT_JUPYTERLAB=8888    KINGO_PORT_JUPYTERHUB=8000
#   KINGO_PORT_MCP=4040           KINGO_PORT_METABASE=3000
#   KINGO_PORT_CLOUDBEAVER=8978   KINGO_PORT_QDRANT=6333
#   KINGO_PORT_QDRANT_GRPC=6334   KINGO_PORT_POSTGRES=5432
# `.env.local` can also pin the engine:  KINGO_ENGINE=docker
