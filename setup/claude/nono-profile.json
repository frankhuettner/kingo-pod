{
  // nono profile for `kingo claude` — written to ~/.config/nono/profiles/kingo-claude.json
  // on every start (ports filled in), from setup/claude/nono-profile.json.
  // Claude writes only to the course folder (claude/) and its own config (~/.kingo-claude);
  // kingo claude adds read access to the kingo-pod folder (--read). The network stays open:
  // nono's proxy lets every host through. It injects the keys for OpenRouter, n8n and Langflow,
  // which nono reads from the files in __KEYS_DIR__: the keys are never in an environment variable.
  // psql goes to PostgreSQL directly: one rule for that port, at the end of this file.
  // Needs nono 0.80. Checked on a Mac with nono 0.81 (nono profile validate, nono run --dry-run).
  "extends": "default",
  "meta": {
    "name": "kingo-claude",
    "version": "0.4.3",
    "description": "Kingo: Claude Code via OpenRouter; writes only to the course folder; keys for OpenRouter, n8n and Langflow injected by the proxy"
  },
  "security": {
    // Windows: WSL2 with Microsoft's kernel (6.6, Landlock V3) cannot force Claude's traffic through
    // nono's proxy, and nono then refuses to start ("proxy-only network mode cannot be
    // kernel-enforced"). With this line it starts and prints a warning: on that kernel, the network
    // is not locked. No effect on a Mac.
    "wsl2_proxy_policy": "insecure_proxy"
  },
  "groups": {
    "include": [
      "git_config",
      "node_runtime",
      "python_runtime",
      "unlink_protection",
      { "name": "claude_cache_linux", "when": "linux" },
      { "name": "linux_sysfs_read", "when": "linux" }
    ]
  },
  "workdir": { "access": "readwrite" },
  "filesystem": {
    // A separate Claude config: the student's own ~/.claude stays untouched and invisible.
    "allow": [
      "$HOME/.kingo-claude",
      "$HOME/.kingo-claude.lock",
      "$HOME/.local/state/claude/locks",
      "$HOME/.cache/claude",
      { "path": "$HOME/Library/Caches/claude-cli-nodejs", "when": "macos" }
    ],
    // The Claude Code binary from the native installer.
    "read": ["$HOME/.local/share/claude"]
  },
  "environment": {
    // Only these variables reach Claude; everything else (other API keys, .env) is dropped.
    // SHLVL counts how many shells deep a program runs. Without it, the bash that runs Claude Code's commands
    // takes itself for the first shell of a remote login and reads /etc/bash.bashrc and ~/.bashrc first. The
    // sandbox refuses both, and every result of a command then starts with two lines "Permission denied".
    "allow_vars": [
      "PATH", "HOME", "USER", "LOGNAME", "SHELL", "SHLVL",
      "TERM", "TERM_PROGRAM", "COLORTERM", "LANG", "LC_*", "TZ",
      "XDG_RUNTIME_DIR",
      "CLAUDE_CONFIG_DIR", "CLAUDE_CODE_TMPDIR", "TMPDIR",
      "CLAUDE_CODE_DISABLE_ARTIFACT", "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC", "DISABLE_TELEMETRY", "DISABLE_ERROR_REPORTING",
      "CLAUDE_CODE_MAX_CONTEXT_TOKENS",
      "KINGO_BROWSER", "KINGO_BROWSER_MODE",
      "PGHOST", "PGPORT", "PGUSER", "PGPASSWORD", "PGDATABASE"
    ]
  },
  "network": {
    // No allow_domain: the proxy lets every host through. The routes only inject keys.
    "credentials": ["anthropic", "n8n", "langflow"],
    // With key routes, nono lets Claude connect only to nono's own proxy port.
    // psql does not use the proxy: see the PostgreSQL rule at the end of this file.
    "custom_credentials": {
      // Named "anthropic" so nono sets ANTHROPIC_BASE_URL=http://127.0.0.1:<port>/anthropic.
      "anthropic": {
        "upstream": "https://openrouter.ai/api",
        "credential_key": "file://__KEYS_DIR__/openrouter.key",
        "env_var": "ANTHROPIC_AUTH_TOKEN",
        "inject_header": "Authorization",
        "credential_format": "Bearer {}"
      },
      // nono sets N8N_BASE_URL; Claude sends X-N8N-API-KEY: $N8N_API_KEY (a placeholder).
      "n8n": {
        "upstream": "http://127.0.0.1:__N8N_PORT__",
        "credential_key": "file://__KEYS_DIR__/n8n.key",
        "env_var": "N8N_API_KEY",
        "inject_header": "X-N8N-API-KEY",
        "credential_format": "{}"
      },
      // nono sets LANGFLOW_BASE_URL; Claude sends x-api-key: $LANGFLOW_API_KEY (a placeholder).
      "langflow": {
        "upstream": "http://127.0.0.1:__LANGFLOW_PORT__",
        "credential_key": "file://__KEYS_DIR__/langflow.key",
        "env_var": "LANGFLOW_API_KEY",
        "inject_header": "x-api-key",
        "credential_format": "{}"
      }
    }
  },
  // PostgreSQL, the one port besides the proxy that Claude may connect to.
  // Mac: a rule of its own for exactly this connection. nono's open_port would also let every
  // program in the sandbox listen on any port (Seatbelt cannot limit listening to one port).
  // nono puts such a rule after its own "(deny network*)" only since 0.80; before, it has no effect.
  "unsafe_macos_seatbelt_rules": [
    "(allow network-outbound (remote tcp \"localhost:__POSTGRES_PORT__\"))"
  ],
  // Linux and Windows (WSL2): open_port, which is limited to this port there.
  "platform_overrides": {
    "linux": { "network": { "open_port": [__POSTGRES_PORT__] } }
  }
}
