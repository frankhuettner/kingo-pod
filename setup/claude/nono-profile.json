{
  // nono profile "kingo-claude", the course profile of `kingo claude` — written to
  // ~/.config/nono/profiles/kingo-claude.json on every start, from this file.
  // It names two profiles, and nono puts them together: lists are joined, and nothing is taken away.
  //   kingo-claude-base    (nono-profile-base.json)    the way to OpenRouter, and Claude Code's config folder
  //   kingo-claude-course  (nono-profile-course.json)  n8n, Langflow and PostgreSQL
  // Both extend "kingo-claude-core" (nono-profile-core.json): what Claude Code may read, the variables,
  // the rule for look. kingo claude adds read access to the kingo-pod folder (--read).
  // Written for nono 0.81.0, the version that kingo downloads and starts (CLAUDE_NONO_VERSION in kingo); needs 0.80.
  "extends": ["kingo-claude-base", "kingo-claude-course"],
  "meta": {
    "name": "kingo-claude",
    "version": "0.6.0",
    "description": "Kingo: Claude Code via OpenRouter; writes only to the course folder; keys for OpenRouter, n8n and Langflow injected by the proxy"
  }
}
