{
  // Your own additions to the sandbox of ./kingo claude.
  //
  // How to use it: copy this file into the kingo-pod folder under the name my-nono-profile.json, change it,
  // and start ./kingo claude again:
  //     cp setup/claude/my-nono-profile.example.json my-nono-profile.json
  // kingo then starts nono with your file. To go back to the sandbox of the course, delete or rename it.
  //
  // What it is: a profile for nono, the sandbox. "extends" says that it adds to the course profile
  // (setup/claude/nono-profile.json and nono-profile-base.json; read them to see what Claude Code gets).
  // nono joins the lists of the two. You can add here; you cannot take away what the course profile gives.
  // The line "extends" must stay as it is: without it, kingo does not start Claude Code.
  //
  // Claude Code can read this file and cannot change it: the kingo-pod folder is read-only in the sandbox.
  // So the sandbox is yours to widen, not Claude's.
  //
  // __KINGO_DIR__ stands for the kingo-pod folder; kingo fills it in. $HOME is your home folder.
  // __KEYS_DIR__ stands for the folder where kingo keeps your keys (~/.config/kingo), for a route to another
  // provider of the model: "credential_key": "file://__KEYS_DIR__/my-provider.key".
  // A folder must exist before the start: nono grants only folders that are there.
  "extends": "kingo-claude",
  "meta": {
    "name": "kingo-claude-mine",
    "version": "1",
    "description": "My additions to the sandbox of kingo claude"
  },
  "filesystem": {
    // "allow": folders that Claude Code may read AND write.
    // The example: kingo-pod/shared, the folder that Langflow sees as /app/shared. With it, Claude Code can
    // put a file there for a flow, and it can change or delete every file that is there.
    "allow": ["__KINGO_DIR__/shared"],
    // "read": folders that Claude Code may read and not write. For example your notes:
    //   "read": ["$HOME/Documents/thesis-notes"]
    "read": []
  }
}
